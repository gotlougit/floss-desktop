-void KioFtp::connectToHost()
-{
-    const QString &target = m_kded->preferredTarget(m_host);
-
-    if (target != QLatin1String("ftp")) {
-        if (createSession(target)) {
-            return;
-        }
-        // Fallback to ftp
-    }
-
-    createSession(QStringLiteral("ftp"));
-}
