diff --git a/src/floss/CMakeLists.txt b/src/floss/CMakeLists.txt
new file mode 100644
index 00000000..9e4754eb
--- /dev/null
+++ b/src/floss/CMakeLists.txt
@@ -0,0 +1,18 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+ecm_add_qml_module(bluedevilfloss URI org.kde.bluedevil.floss GENERATE_PLUGIN_SOURCE)
+set(floss_backend_sources flossbackend.cpp flossbackend.h flossdevices.cpp flossreconnect.cpp flossreconnect.h flossrfkill.cpp)
+target_sources(bluedevilfloss PRIVATE ${floss_backend_sources})
+ecm_target_qml_sources(bluedevilfloss SOURCES PairingWindow.qml DeviceNameDialog.qml)
+target_link_libraries(bluedevilfloss PRIVATE Qt::Core Qt::DBus Qt::Qml Qt::Quick KF6::I18n)
+ecm_finalize_qml_module(bluedevilfloss)
+
+# The same backend keeps reconnect policy alive when no Bluetooth view is open.
+add_executable(bluedevil-floss-policy flosspolicy.cpp ${floss_backend_sources})
+target_link_libraries(bluedevil-floss-policy PRIVATE Qt::Core Qt::DBus Qt::Qml KF6::I18n)
+install(TARGETS bluedevil-floss-policy DESTINATION ${KDE_INSTALL_BINDIR})
+
+# Keep the existing pairing window available even without a tray or settings
+# view. The QML plugin provides the backend and its shared responder election.
+add_executable(bluedevil-floss-pairing pairingagent.cpp)
+target_link_libraries(bluedevil-floss-pairing PRIVATE Qt::Core Qt::Gui Qt::Qml Qt::Quick KF6::I18n KF6::I18nQml)
+install(TARGETS bluedevil-floss-pairing DESTINATION ${KDE_INSTALL_BINDIR})
