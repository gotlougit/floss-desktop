+    modal: true
+    standardButtons: QQC2.Dialog.Save | QQC2.Dialog.Cancel
+    onAccepted: FlossBackend.setAlias(deviceAddress, nameField.text)
+    onOpened: { nameField.forceActiveFocus(); nameField.selectAll(); }
+    contentItem: QQC2.TextField {
+        id: nameField
+        implicitWidth: 300
+        placeholderText: qsTr("Leave empty to use the device's original name")
+        Accessible.name: qsTr("Device name")
+        onAccepted: root.accept()
+    }
+    function rename(device): void {
+        deviceAddress = device.address;
+        nameField.text = device.alias || "";
+        open();
+    }
+}
diff --git a/src/floss/PairingWindow.qml b/src/floss/PairingWindow.qml
new file mode 100644
index 00000000..75eb1f6e
--- /dev/null
+++ b/src/floss/PairingWindow.qml
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+pragma ComponentBehavior: Bound
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.kirigami as Kirigami
+import org.kde.bluedevil.floss
+
+// A top-level window also surfaces pairing when the tray popup is closed.
+Window {
+    id: root
+    readonly property var request: FlossBackend.pairing
+    property string viewId: ""
+    property string lastToken: ""
+    readonly property bool canAnswer: !request.pending && !request.answered && !request.expired && !request.cancelRequested && !request.uncertain
+    Component.onCompleted: viewId = FlossBackend.attachPairingView()
+    Component.onDestruction: FlossBackend.detachPairingView(viewId)
+    readonly property bool inputRequired: request.kind === "pin" || request.kind === "passkey"
+    visible: !!request.address && request.view === viewId
+    title: i18n("Bluetooth Pairing")
+    width: Kirigami.Units.gridUnit * 24
+    height: contents.implicitHeight + Kirigami.Units.largeSpacing * 2
+    onClosing: close => {
+        close.accepted = false;
+        FlossBackend.answerPairing(root.request.token || "", false);
+    }
+    Connections {
+        target: FlossBackend
+        function onPairingChanged(): void {
+            if (root.lastToken !== (root.request.token || "")) {
+                root.lastToken = root.request.token || "";
+                pin.clear();
+                if (root.visible) root.requestActivate();
+            }
+        }
+    }
+    ColumnLayout {
+        id: contents
+        anchors.fill: parent
+        anchors.margins: Kirigami.Units.largeSpacing
+        QQC2.Label {
+            Layout.fillWidth: true
+            wrapMode: Text.Wrap
+            textFormat: Text.PlainText
+            text: i18n("Pair with %1 (%2)", root.request.name || "", root.request.address || "")
+        }
+        QQC2.Label {
+            Layout.fillWidth: true
+            wrapMode: Text.Wrap
+            textFormat: Text.PlainText
+            text: root.request.kind === "display" ? i18n("Enter this code on the Bluetooth device: %1", root.request.code)
+                : root.request.kind === "confirm" ? i18n("Does this code match the device? %1", root.request.code)
+                : root.request.kind === "passkey" ? i18n("Enter the six-digit passkey shown on the device.")
+                : root.request.minimum === 16 ? i18n("Enter the device's 16-byte PIN.") : i18n("Enter the device's PIN.")
+        }
+        QQC2.TextField {
+            id: pin
+            Layout.fillWidth: true
+            visible: root.inputRequired
+            enabled: root.canAnswer
+            maximumLength: root.request.kind === "passkey" ? 6 : 16
+            inputMethodHints: root.request.kind === "passkey" ? Qt.ImhDigitsOnly : Qt.ImhNone
+            onAccepted: FlossBackend.answerPairing(root.request.token || "", true, text)
+        }
+        QQC2.Label {
+            Layout.fillWidth: true
+            wrapMode: Text.Wrap
+            textFormat: Text.PlainText
+            visible: FlossBackend.error.length > 0
+            text: FlossBackend.error
+        }
+        QQC2.Label {
+            Layout.fillWidth: true
+            wrapMode: Text.Wrap
+            visible: !root.canAnswer
+            text: root.request.cancelRequested ? (root.request.pending ? i18n("Cancelling pairing…") : i18n("Cancellation failed. Retry Cancel."))
+                : root.request.uncertain ? i18n("The response could not be confirmed. Cancel pairing before trying again.")
+                : root.request.pending ? i18n("Sending response…") : i18n("Waiting for pairing to finish…")
+        }
+        RowLayout {
+            Layout.alignment: Qt.AlignRight
+            QQC2.Button {
+                property string responseToken: ""
+                text: i18n("Cancel")
+                onPressed: responseToken = root.request.token || ""
+                onClicked: FlossBackend.answerPairing(responseToken, false)
+            }
+            QQC2.Button {
+                property string responseToken: ""
+                enabled: root.canAnswer
+                onPressed: responseToken = root.request.token || ""
+                text: root.request.kind === "display" ? i18n("Continue") : i18n("Accept")
+                onClicked: FlossBackend.answerPairing(responseToken, true, pin.text)
+            }
+        }
+    }
+}
diff --git a/src/floss/README.md b/src/floss/README.md
new file mode 100644
index 00000000..e63782dd
--- /dev/null
+++ b/src/floss/README.md
@@ -0,0 +1,134 @@
+# Floss-only BlueDevil integration
+
+This integration keeps Plasma's Bluetooth tray, expandable device rows, toolbar,
+Bluetooth System Settings list/detail pages and forget confirmation, while
+replacing their Bluetooth implementation with native Floss D-Bus calls.
+There is one backend and no backend-selection environment variable. Set
+`BLUEDEVIL_FLOSS_ADAPTER` to select an HCI index (default `0`).
+
+`org.kde.bluedevil.floss` supplies a native Qt list model and pairing window.
+The model exposes desktop device snapshots and operation state; it is not an
+implementation of the BlueZ API or a renamed BluezQt library. Qt still supplies
+D-Bus marshalling. Floss owns bonds, profiles and Bluetooth protocols.
+The tray's activation metadata follows the Floss manager service.
+
+The existing applet and KCM are the installed desktop entry points. Obsolete
+KDED agents/device monitoring, BlueZ proxy models, standalone pairing wizard,
+OBEX/send-file tools, KIO workers, network-profile hooks, and their source/build
+targets have been removed. The unsupported UI controls were removed with them.
+The generic applet and KCM smoke-test definitions remain for future use;
+no tests have been run. BluezQt is no longer a build or runtime dependency of
+this integration. The checkout requires Qt 6.11, KF6
+6.30 and Plasma 6.7.90; packaging must align those versions.
+
+Implemented paths cover manager Start/Stop, discovery, initial bonded/connected
+device enumeration, bonding, explicit PIN/passkey requests, numeric comparison,
+PIN/passkey display, connect/disconnect and bond removal. Pair Device starts
+native discovery in the existing list. Floss stores the real bonds; there is
+no shadow trusted/blocked database. Normal Floss startup owns media setup;
+the separate PipeWire integration owns audio routing.
+
+Callbacks authenticate the current unique owner of `org.chromium.bluetooth`.
+Daemon replacement clears state and invalidates old asynchronous replies.
+D-Bus requests and bond completion waits have bounded timeouts. Successful
+locally requested bonding chains `ConnectAllEnabledProfiles`, including Floss's
+connection of profiles discovered later. Connect Profiles remains available
+for paired devices with an existing ACL. Connect/disconnect replies record
+request acceptance only; neither ACL callbacks nor an existing ACL complete a
+profile-readiness operation. The details explicitly report profile readiness as
+unknown. Later connection failures remain visible even after request acceptance.
+"Link connected" and the badge describe ACL links, not audio readiness.
+Device snapshots are grouped and sorted in the native list model, with targeted
+row insertions/removals/moves and data updates instead of full model resets.
+Keyboard focus still needs runtime validation, particularly across row movement.
+
+Only the backend holding session name `org.kde.bluedevil.FlossPairing` answers
+pairing callbacks. Each QML engine has a distinct private session-bus connection
+and UUID system-bus callback path. Only successfully exported callback objects
+are unregistered. A backend holds the pairing name only while a PairingWindow
+exists; multiple windows in one engine select one view. Losing the last view or
+exiting releases ownership. The owner uses a top-level window even when the tray
+is collapsed. The removed handbook is no longer advertised by the KCM Help action.
+
+Observers cache pairing callbacks for their original 45-second lifetime. A new
+owner checks that a cached device is still Bonding before showing the prompt;
+terminal bond events, device removal and daemon replacement discard it. A newly
+started observer cannot recover callbacks it never received. Recovery never
+automatically accepts a pairing request. Floss exposes no authoritative pending
+pairing transaction ID: if an owner dies after transmitting an answer but before
+bond completion, another process cannot determine whether that answer took
+effect. Requests received as an observer are therefore marked uncertain: after
+takeover they retain their Cancel action but cannot submit an answer. Cancel and
+pair again to obtain a fresh request under the new owner. This deliberately
+preserves recovery UI without risking a duplicate PIN/SSP response.
+This is not a crash-transactional pairing broker or coordination with other clients.
+
+Within a backend, each prompt has a UUID; UI responses, D-Bus replies and expiry
+handlers must match it. Button presses retain that UUID across release. PIN input
+survives a rejected response. An acknowledged answer keeps its identity and a
+Cancel action until the terminal bond event; display notifications never send a
+confirmation. A transport error leaves an uncertain response with resubmission
+disabled, since it might already have reached Floss. Cancel uses CancelBondProcess
+and clears the prompt only on cancellation acknowledgment or a terminal event.
+Expiry queues cancellation after any in-flight answer returns rather than sending
+conflicting responses concurrently. Failed cancellation keeps the request and a
+retry action. These local tokens cannot make Floss's address-only cancellation
+transactional against another independent client. Floss handles SSP Consent itself
+and its existing policy decides unsolicited Just Works pairing.
+
+## Remaining work
+
+* One configured adapter; no adapter chooser, manager hotplug callback model,
+  platform-wide rfkill switch control, or multi-session/seat arbitration. The session name only
+  coordinates this integration's processes in one session, not other Floss clients.
+* The standalone `bluedevil-floss-pairing` process keeps PairingWindow loaded
+  without the tray or KCM. It stays hidden until a request arrives and shares
+  the same session responder election with those views. It does not take
+  ownership away from an existing responder. Cached ownership handoff and
+  multiple QML engines need runtime validation;
+  native transaction IDs/pending-request replay would be needed for complete
+  recovery across abrupt crashes or clients that were not already observing.
+* Device-specific icons, trusted/blocked
+  controls, discoverability settings, media controls, OBEX/file transfer,
+  network sharing, profile-specific status, suspend coordination and
+  remembered power state are absent. They are not cosmetic emulations.
+* Discovery is shared adapter state; there is no per-client discovery lease.
+* Packaging must allow the desktop user to call Floss and Floss to call the
+  unique-name callback object on the system bus. This code does not grant
+  permissions or activate another stack as a fallback.
+* Adapter removal within a still-running Floss daemon needs further state
+  invalidation; the current lifecycle watcher tracks daemon ownership.
+
+No compiler, QML linter, tests, configure step or runtime checks were run and
+no dependencies were downloaded. Source has been read for consistency only.
+After approval, validate build/QML registration, original UI layout and keyboard
+navigation, callback contracts, hostile senders, daemon restarts, initial state
+races and pairing cancellation with small fakes before real-device testing.
+
+## Desktop device details and reconnect
+
+BatteryManager registration precedes snapshots; callbacks authenticate the current
+Floss owner and invalidate older reads. Unknown/out-of-range readings are omitted,
+zero is valid, and distinct headset components are displayed separately. Device
+aliases use native Get/SetRemoteAlias; setter acceptance alone is not success.
+Rename waits for confirmed state and rejects stale responses after removal/reset.
+
+`bluedevil-floss-policy` keeps reconnect alive without an open view. It uses the
+same backend and a per-session/adapter D-Bus election to avoid duplicate retries.
+Paired devices retry after five seconds, backing off to five minutes; accepted
+requests wait up to thirty seconds for actual link state. Shared QSettings state
+persists inhibition and backoff across policy restarts. Disconnect/Forget inhibit
+retries until explicit Connect/Pair. A bounded 45-second reconciliation window
+handles late completion of an earlier connection; this is not a device security
+block. Automatic retry errors remain silent; explicit connection failures remain
+visible. Per-profile failure with an intact ACL link still needs separate policy.
+
+## Controller radio blocks
+
+The manager exposes `GetRfkillState(i)` and `SetRfkillBlocked(i,b)`. The desktop
+polls current state and enabling Bluetooth first unblocks a software-blocked
+controller, confirms fresh state, then requests Start. Hardware blocks are
+reported with a hardware-switch message; failed unblocks do not claim success.
+Only an unambiguous kernel hciN switch associated with the manager's physical
+adapter identity is eligible. Platform-wide switches and unknown identities are
+unavailable rather than guessed. The desktop never opens /dev/rfkill itself.
diff --git a/src/floss/flossbackend.cpp b/src/floss/flossbackend.cpp
new file mode 100644
index 00000000..71ab5e6b
--- /dev/null
+++ b/src/floss/flossbackend.cpp
@@ -0,0 +1,590 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "flossbackend.h"
+#include "flossreconnect.h"
+
+#include <QCoreApplication>
+#include <QUuid>
+#include <QDBusArgument>
+#include <QDBusConnection>
+#include <QDBusConnectionInterface>
+#include <QDBusMessage>
+#include <QDBusMetaType>
+#include <QDBusObjectPath>
+#include <QDBusPendingCallWatcher>
+#include <QDBusServiceWatcher>
+#include <QDBusVirtualObject>
+#include <QRegularExpression>
+#include <KLocalizedString>
+#include <cstring>
+#include <algorithm>
+
+namespace {
+const QString service = QStringLiteral("org.chromium.bluetooth");
+const QString adapterInterface = QStringLiteral("org.chromium.bluetooth.Bluetooth");
+const QString pairingService = QStringLiteral("org.kde.bluedevil.FlossPairing");
+using DeviceList = QList<QVariantMap>;
+QVariantMap map(const QVariant &value) { return qdbus_cast<QVariantMap>(value); }
+}
+
+class FlossCallbacks : public QDBusVirtualObject
+{
+public:
+    explicit FlossCallbacks(FlossBackend *backend) : QDBusVirtualObject(backend), m_backend(backend) {}
+    QString introspect(const QString &) const override { return {}; }
+    bool handleMessage(const QDBusMessage &message, const QDBusConnection &connection) override
+    {
+        if (message.service() != m_backend->m_owner || m_backend->m_owner.isEmpty()) {
+            connection.send(message.createErrorReply(QStringLiteral("org.freedesktop.DBus.Error.AccessDenied"), QStringLiteral("Not the current Floss daemon")));
+            return true;
+        }
+        if (message.interface() != QStringLiteral("org.chromium.bluetooth.BluetoothCallback")
+            && message.interface() != QStringLiteral("org.chromium.bluetooth.BluetoothConnectionCallback")
+            && message.interface() != QStringLiteral("org.chromium.bluetooth.BatteryManagerCallback")) {
+            return false;
+        }
+        m_backend->callback(message);
+        connection.send(message.createReply());
+        return true;
+    }
+private:
+    FlossBackend *m_backend;
+};
+
+FlossBackend::FlossBackend(QObject *parent) : QAbstractListModel(parent)
+{
+    connect(this, &FlossBackend::changed, this, [this]() {
+        const auto rows = devices();
+        // Keep delegates (and their keyboard focus) when only their data changes.
+        const auto addressOf = [](const QVariant &row) { return row.toMap().value(QStringLiteral("address")).toString(); };
+        for (int row = m_rows.size() - 1; row >= 0; --row) {
+            const auto address = addressOf(m_rows[row]);
+            if (std::none_of(rows.cbegin(), rows.cend(), [&](const QVariant &item) { return addressOf(item) == address; })) {
+                beginRemoveRows({}, row, row);
+                m_rows.removeAt(row);
+                endRemoveRows();
+            }
+        }
+        for (int row = 0; row < rows.size(); ++row) {
+            int oldRow = row;
+            while (oldRow < m_rows.size() && addressOf(m_rows[oldRow]) != addressOf(rows[row])) ++oldRow;
+            if (oldRow == m_rows.size()) {
+                beginInsertRows({}, row, row);
+                m_rows.insert(row, rows[row]);
+                endInsertRows();
+            } else if (oldRow != row) {
+                beginMoveRows({}, oldRow, oldRow, {}, row);
+                m_rows.move(oldRow, row);
+                endMoveRows();
+            }
+            if (m_rows[row] != rows[row]) {
+                m_rows[row] = rows[row];
+                Q_EMIT dataChanged(index(row, 0), index(row, 0), {Qt::UserRole + 1, Qt::UserRole + 2});
+            }
+        }
+    });
+    connect(this, &FlossBackend::pairingChanged, this, [this]() {
+        const auto address = m_pairing.value(QStringLiteral("address")).toString();
+        auto cached = m_pairingCache.find(address);
+        if (cached != m_pairingCache.end() && cached->value(QStringLiteral("token")) == m_pairing.value(QStringLiteral("token"))) {
+            // Never replay an answer whose result was lost during view handoff.
+            cached->insert(QStringLiteral("answered"), m_pairing.value(QStringLiteral("answered")));
+            cached->insert(QStringLiteral("uncertain"), m_pairing.value(QStringLiteral("uncertain")).toBool()
+                || m_pairing.value(QStringLiteral("pending")).toBool());
+        }
+    });
+    bool valid = false;
+    const int adapter = qEnvironmentVariableIntValue("BLUEDEVIL_FLOSS_ADAPTER", &valid);
+    if (valid && adapter >= 0) {
+        m_adapter = adapter;
+    }
+    qDBusRegisterMetaType<DeviceList>();
+    m_path = QStringLiteral("/org/chromium/bluetooth/hci%1/adapter").arg(m_adapter);
+    const auto instance = QUuid::createUuid().toString(QUuid::Id128);
+    m_callbackPath = QStringLiteral("/org/kde/bluedevil/floss/i%1").arg(instance);
+    m_callbacks = new FlossCallbacks(this);
+    if (!QDBusConnection::systemBus().registerVirtualObject(m_callbackPath, m_callbacks)) {
+        fail(i18n("Could not export Floss callbacks."));
+        return;
+    }
+    m_callbackExported = true;
+    auto *watcher = new QDBusServiceWatcher(service, QDBusConnection::systemBus(), QDBusServiceWatcher::WatchForOwnerChange, this);
+    connect(watcher, &QDBusServiceWatcher::serviceOwnerChanged, this, [this](const QString &, const QString &, const QString &owner) { reset(owner); });
+    // Each QML engine needs its own bus identity: the shared sessionBus()
+    // connection otherwise considers all engines in one process the same owner.
+    m_pairingConnection = QStringLiteral("bluedevil-pairing-%1").arg(instance);
+    const auto pairingBus = QDBusConnection::connectToBus(QDBusConnection::SessionBus, m_pairingConnection);
+    auto *pairingWatcher = new QDBusServiceWatcher(pairingService, pairingBus, QDBusServiceWatcher::WatchForUnregistration, this);
+    connect(pairingWatcher, &QDBusServiceWatcher::serviceUnregistered, this, &FlossBackend::acquirePairing);
+    m_retry.setInterval(3000);
+    connect(&m_retry, &QTimer::timeout, this, &FlossBackend::initialize);
+    m_retry.start();
+    m_radioTimer.setInterval(3000);
+    connect(&m_radioTimer, &QTimer::timeout, this, &FlossBackend::refreshRadioState);
+    m_radioTimer.start();
+    refreshRadioState();
+    const auto owner = QDBusConnection::systemBus().interface()->serviceOwner(service);
+    reset(owner.isValid() ? owner.value() : QString());
+    m_reconnect = new FlossReconnect(this);
+}
+
+FlossBackend::~FlossBackend()
+{
+    delete m_reconnect;
+    unregisterDeviceDetails();
+    if (m_callbackRegistered) call(QStringLiteral("UnregisterCallback"), {m_callbackId});
+    if (m_connectionRegistered) call(QStringLiteral("UnregisterConnectionCallback"), {m_connectionId});
+    if (m_callbackExported) QDBusConnection::systemBus().unregisterObject(m_callbackPath);
+    if (m_pairingOwner) QDBusConnection(m_pairingConnection).unregisterService(pairingService);
+    if (!m_pairingConnection.isEmpty()) QDBusConnection::disconnectFromBus(m_pairingConnection);
+}
+
+void FlossBackend::fail(const QString &message) { m_error = message; Q_EMIT changed(); }
+void FlossBackend::clearError() { m_error.clear(); Q_EMIT changed(); }
+QVariantList FlossBackend::devices() const
+{
+    QVariantList result;
+    for (auto device : m_devices) {
+        const auto alias = device.value(QStringLiteral("alias")).toString();
+        if (!alias.isEmpty()) device.insert(QStringLiteral("name"), alias);
+        const bool connected = device.value(QStringLiteral("connected")).toBool();
+        const bool paired = device.value(QStringLiteral("paired")).toBool();
+        device.insert(QStringLiteral("section"), connected ? i18n("Link connected") : paired ? i18n("Paired") : i18n("Available"));
+        device.insert(QStringLiteral("icon"), QStringLiteral("preferences-system-bluetooth"));
+        result.append(device);
+    }
+    std::sort(result.begin(), result.end(), [](const QVariant &leftValue, const QVariant &rightValue) {
+        const auto left = leftValue.toMap();
+        const auto right = rightValue.toMap();
+        for (const auto &key : {QStringLiteral("connected"), QStringLiteral("paired")}) {
+            if (left.value(key).toBool() != right.value(key).toBool()) return left.value(key).toBool();
+        }
+        return QString::localeAwareCompare(left.value(QStringLiteral("name")).toString(), right.value(QStringLiteral("name")).toString()) < 0;
+    });
+    return result;
+}
+int FlossBackend::rowCount(const QModelIndex &parent) const
+{
+    return parent.isValid() ? 0 : m_rows.size();
+}
+QVariant FlossBackend::data(const QModelIndex &index, int role) const
+{
+    if (!index.isValid() || index.row() < 0 || index.row() >= m_rows.size()) return {};
+    if (role == Qt::UserRole + 1) return m_rows[index.row()];
+    if (role == Qt::UserRole + 2) return m_rows[index.row()].toMap().value(QStringLiteral("section"));
+    return {};
+}
+QHash<int, QByteArray> FlossBackend::roleNames() const
+{
+    return {{Qt::UserRole + 1, "modelData"}, {Qt::UserRole + 2, "section"}};
+}
+
+QVariantMap FlossBackend::deviceArgument(const QString &address) const
+{
+    return {{QStringLiteral("address"), address}, {QStringLiteral("name"), m_devices.value(address).value(QStringLiteral("name"), address)}};
+}
+
+void FlossBackend::reset(const QString &owner)
+{
+    ++m_epoch;
+    m_owner = owner;
+    m_ready = false;
+    m_initializing = false;
+    m_callbackRegistered = m_connectionRegistered = false;
+    m_devices.clear();
+    resetDeviceDetails();
+    m_deviceRevisions.clear();
+    m_operations.clear();
+    m_pairing.clear();
+    m_pairingCache.clear();
+    m_pairingValidation = false;
+    m_discovering = false;
+    m_error = owner.isEmpty() ? i18n("Floss is not running.") : QString();
+    Q_EMIT pairingChanged();
+    Q_EMIT changed();
+    initialize();
+}
+
+void FlossBackend::call(const QString &method, const QVariantList &args, std::function<void(const QDBusMessage &)> done, bool reportErrors)
+{
+    if (m_owner.isEmpty()) { fail(i18n("Floss is not running.")); return; }
+    auto message = QDBusMessage::createMethodCall(m_owner, m_path, adapterInterface, method);
+    message.setArguments(args);
+    const auto epoch = m_epoch;
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(message, 10000), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, watcher, epoch, done, reportErrors](QDBusPendingCallWatcher *) {
+        const auto reply = watcher->reply();
+        watcher->deleteLater();
+        if (epoch != m_epoch) return;
+        if (reportErrors && reply.type() == QDBusMessage::ErrorMessage) fail(reply.errorMessage());
+        if (done) done(reply);
+    });
+}
+
+void FlossBackend::initialize()
+{
+    if (m_ready) { initializeDeviceDetails(); return; }
+    if (m_initializing || m_owner.isEmpty()) return;
+    m_initializing = true;
+    const QVariant callbackPath = QVariant::fromValue(QDBusObjectPath(m_callbackPath));
+    const auto registerConnection = [this, callbackPath]() {
+        call(QStringLiteral("RegisterConnectionCallback"), {callbackPath}, [this](const QDBusMessage &reply) {
+            m_initializing = false;
+            if (reply.type() == QDBusMessage::ErrorMessage) return;
+            m_connectionId = reply.arguments().value(0).toUInt();
+            m_connectionRegistered = true;
+            m_ready = true;
+            initializeDeviceDetails();
+            m_error.clear();
+            Q_EMIT changed();
+            call(QStringLiteral("IsDiscovering"), {}, [this](const QDBusMessage &state) {
+                if (state.type() != QDBusMessage::ErrorMessage) { m_discovering = state.arguments().value(0).toBool(); Q_EMIT changed(); }
+            });
+            for (const auto &method : {QStringLiteral("GetBondedDevices"), QStringLiteral("GetConnectedDevices")}) {
+                call(method, {}, [this](const QDBusMessage &list) {
+                    if (list.type() == QDBusMessage::ErrorMessage) return;
+                    for (const auto &device : qdbus_cast<DeviceList>(list.arguments().value(0))) readDevice(device);
+                });
+            }
+        });
+    };
+    if (m_callbackRegistered) { registerConnection(); return; }
+    call(QStringLiteral("RegisterCallback"), {callbackPath}, [this, registerConnection](const QDBusMessage &reply) {
+        if (reply.type() == QDBusMessage::ErrorMessage) { m_initializing = false; return; }
+        m_callbackId = reply.arguments().value(0).toUInt();
+        m_callbackRegistered = true;
+        registerConnection();
+    });
+}
+
+void FlossBackend::readDevice(const QVariantMap &device)
+{
+    const QString address = device.value(QStringLiteral("address")).toString();
+    if (address.isEmpty()) return;
+    auto &stored = m_devices[address];
+    stored.insert(QStringLiteral("address"), address);
+    const auto name = device.value(QStringLiteral("name")).toString();
+    if (!name.isEmpty() || !stored.contains(QStringLiteral("name"))) {
+        stored.insert(QStringLiteral("name"), name.isEmpty() ? address : name);
+    }
+    Q_EMIT changed();
+    for (const auto &method : {QStringLiteral("GetBondState"), QStringLiteral("GetRemoteConnected")}) {
+        // Reject snapshots that predate a state-changing callback/operation.
+        const auto revision = m_deviceRevisions.value(address);
+        call(method, {deviceArgument(address)}, [this, address, method, revision](const QDBusMessage &reply) {
+            if (reply.type() == QDBusMessage::ErrorMessage || !m_devices.contains(address) || revision != m_deviceRevisions.value(address)) return;
+            if (method == QStringLiteral("GetBondState")) m_devices[address].insert(QStringLiteral("paired"), reply.arguments().value(0).toUInt() == 2);
+            else m_devices[address].insert(QStringLiteral("connected"), reply.arguments().value(0).toBool());
+            readDeviceDetails(address);
+            Q_EMIT changed();
+        });
+    }
+    readDeviceDetails(address);
+}
+
+void FlossBackend::discover(bool enabled)
+{
+    if (!m_ready) return;
+    call(enabled ? QStringLiteral("StartDiscovery") : QStringLiteral("CancelDiscovery"), {}, [this](const QDBusMessage &reply) {
+        if (reply.type() != QDBusMessage::ErrorMessage && !reply.arguments().value(0).toBool()) fail(i18n("Floss rejected the discovery request."));
+    });
+}
+
+void FlossBackend::operate(const QString &address, const QString &operation)
+{
+    if (!m_ready || !m_devices.contains(address) || m_operations.contains(address)) return;
+    QString method;
+    if (operation == QStringLiteral("pair")) method = QStringLiteral("CreateBond");
+    else if (operation == QStringLiteral("connect")) method = QStringLiteral("ConnectAllEnabledProfiles");
+    else if (operation == QStringLiteral("disconnect")) method = QStringLiteral("DisconnectAllEnabledProfiles");
+    else if (operation == QStringLiteral("forget")) method = QStringLiteral("RemoveBond");
+    else { fail(i18n("Unsupported Floss operation.")); return; }
+    if (m_reconnect && !m_reconnect->userOperation(address, operation)) return;
+    const auto serial = ++m_serial;
+    ++m_deviceRevisions[address];
+    m_operations[address] = serial;
+    m_devices[address].insert(QStringLiteral("pending"), operation);
+    Q_EMIT changed();
+    QVariantList args{deviceArgument(address)};
+    if (operation == QStringLiteral("pair")) args.append(QVariant::fromValue(uint(0))); // BtTransport::Auto
+    call(method, args, [this, address, operation, serial](const QDBusMessage &reply) {
+        if (m_operations.value(address) != serial) return;
+        if (reply.type() == QDBusMessage::ErrorMessage) { finish(address, operation, reply.errorMessage()); return; }
+        const auto result = reply.arguments().value(0);
+        const bool accepted = (operation == QStringLiteral("pair") || operation == QStringLiteral("connect")) ? result.toUInt() == 0 : result.toBool();
+        if (!accepted) {
+            finish(address, operation, i18n("Floss rejected the device request."));
+            return;
+        }
+        // This reply acknowledges a profile request, not profile readiness.
+        // ACL callbacks and GetRemoteConnected cannot establish that readiness.
+        if (operation == QStringLiteral("connect") || operation == QStringLiteral("disconnect")) {
+            m_devices[address].insert(QStringLiteral("profileRequest"), operation);
+            finish(address, operation);
+        }
+        // Bond/remove requests still wait for their bond-state callback.
+
+    });
+    QTimer::singleShot(45000, this, [this, address, operation, serial]() {
+        if (m_operations.value(address) == serial) finish(address, operation, i18n("The Bluetooth operation timed out; its final state is unknown."));
+    });
+}
+void FlossBackend::finish(const QString &address, const QString &operation, const QString &error)
+{
+    if (m_devices.value(address).value(QStringLiteral("pending")).toString() != operation) return;
+    m_operations.remove(address);
+    m_devices[address].remove(QStringLiteral("pending"));
+    if (!error.isEmpty()) m_error = error;
+    Q_EMIT changed();
+}
+
+QVariantMap FlossBackend::pairing() const
+{
+    if (!m_pairingOwner || m_pairingViews.isEmpty()) return {};
+    auto result = m_pairing;
+    result.insert(QStringLiteral("view"), m_pairingViews.first());
+    return result;
+}
+
+QString FlossBackend::attachPairingView()
+{
+    const auto view = QUuid::createUuid().toString(QUuid::Id128);
+    m_pairingViews.append(view);
+    acquirePairing();
+    Q_EMIT pairingChanged();
+    return view;
+}
+
+void FlossBackend::detachPairingView(const QString &view)
+{
+    m_pairingViews.removeAll(view);
+    if (m_pairingViews.isEmpty() && m_pairingOwner) {
+        m_pairingOwner = false;
+        m_pairing.clear();
+        QDBusConnection(m_pairingConnection).unregisterService(pairingService);
+    }
+    Q_EMIT pairingChanged();
+}
+
+void FlossBackend::acquirePairing()
+{
+    if (!m_callbackExported || m_pairingViews.isEmpty() || m_pairingOwner) return;
+    m_pairingOwner = QDBusConnection(m_pairingConnection).registerService(pairingService);
+    if (m_pairingOwner) showCachedPairing();
+}
+
+void FlossBackend::showCachedPairing()
+{
+    if (!m_pairingOwner || !m_pairing.isEmpty() || m_pairingValidation || m_pairingCache.isEmpty() || m_owner.isEmpty()) return;
+    const auto request = m_pairingCache.first();
+    const auto address = request.value(QStringLiteral("address")).toString();
+    const auto token = request.value(QStringLiteral("token")).toString();
+    m_pairingValidation = true;
+    // Floss does not replay pending prompts on registration. Observers retain
+    // live callbacks, but only offer a handoff while the device is still bonding.
+    call(QStringLiteral("GetBondState"), {deviceArgument(address)}, [this, address, token](const QDBusMessage &reply) {
+        m_pairingValidation = false;
+        if (!m_pairingOwner || !m_pairing.isEmpty()) return;
+        if (m_pairingCache.value(address).value(QStringLiteral("token")).toString() != token) { showCachedPairing(); return; }
+        if (reply.type() == QDBusMessage::ErrorMessage || reply.arguments().value(0).toUInt() != 1) {
+            m_pairingCache.remove(address);
+            showCachedPairing();
+            return;
+        }
+        m_pairing = m_pairingCache.value(address);
+        Q_EMIT pairingChanged();
+    });
+}
+
+void FlossBackend::clearPairing(const QString &address)
+{
+    m_pairingCache.remove(address);
+    if (m_pairing.value(QStringLiteral("address")).toString() == address) {
+        m_pairing.clear();
+        Q_EMIT pairingChanged();
+    }
+    showCachedPairing();
+}
+
+void FlossBackend::prompt(const QVariantMap &device, const QString &kind, const QString &code, int minimum)
+{
+    const auto address = device.value(QStringLiteral("address")).toString();
+    if (address.isEmpty()) return;
+    if (!m_devices.contains(address)) readDevice(device);
+    auto request = deviceArgument(address);
+    request.insert(QStringLiteral("kind"), kind);
+    request.insert(QStringLiteral("code"), code);
+    request.insert(QStringLiteral("minimum"), minimum);
+    const auto token = QUuid::createUuid().toString(QUuid::Id128);
+    request.insert(QStringLiteral("token"), token);
+    // An observer cannot know whether the owner later submitted an answer.
+    // Bonding alone does not distinguish unanswered from accepted-but-pending.
+    // Preserve the request for cancellation on takeover, never offer a resend.
+    request.insert(QStringLiteral("uncertain"), !m_pairingOwner);
+    m_pairingCache[address] = request;
+    if (m_pairingOwner) {
+        if (m_pairing.isEmpty() || m_pairing.value(QStringLiteral("address")).toString() == address) {
+            m_pairing = request;
+            Q_EMIT pairingChanged();
+        } else {
+            fail(i18n("Another device is already pairing."));
+            call(QStringLiteral("CancelBondProcess"), {device});
+        }
+    }
+    const auto epoch = m_epoch;
+    QTimer::singleShot(45000, this, [this, epoch, address, token]() {
+        if (epoch != m_epoch) return;
+        if (m_pairingCache.value(address).value(QStringLiteral("token")).toString() == token) m_pairingCache.remove(address);
+        if (m_pairingOwner && m_pairing.value(QStringLiteral("token")).toString() == token) {
+            // Never race a second reply against an in-flight PIN/SSP answer.
+            m_pairing.insert(QStringLiteral("expired"), true);
+            cancelPairing(token);
+        }
+    });
+}
+
+void FlossBackend::cancelPairing(const QString &token)
+{
+    if (!m_pairingOwner || token.isEmpty() || m_pairing.value(QStringLiteral("token")).toString() != token) return;
+    m_pairing.insert(QStringLiteral("cancelRequested"), true);
+    if (m_pairing.value(QStringLiteral("pending")).toBool()) { Q_EMIT pairingChanged(); return; }
+    m_pairing.insert(QStringLiteral("pending"), true);
+    Q_EMIT pairingChanged();
+    const auto address = m_pairing.value(QStringLiteral("address")).toString();
+    call(QStringLiteral("CancelBondProcess"), {deviceArgument(address)}, [this, token, address](const QDBusMessage &reply) {
+        if (m_pairing.value(QStringLiteral("token")).toString() != token) return;
+        if (reply.type() != QDBusMessage::ErrorMessage && reply.arguments().value(0).toBool()) {
+            clearPairing(address);
+        } else {
+            m_pairing.insert(QStringLiteral("pending"), false);
+            fail(i18n("Could not cancel pairing. Retry Cancel or wait for the device to finish."));
+            Q_EMIT pairingChanged();
+        }
+    }, false);
+}
+
+void FlossBackend::answerPairing(const QString &token, bool accept, const QString &pin)
+{
+    if (!m_pairingOwner || token.isEmpty() || m_pairing.value(QStringLiteral("token")).toString() != token) return;
+    if (!accept) { cancelPairing(token); return; }
+    if (m_pairing.value(QStringLiteral("pending")).toBool() || m_pairing.value(QStringLiteral("answered")).toBool()
+        || m_pairing.value(QStringLiteral("expired")).toBool() || m_pairing.value(QStringLiteral("cancelRequested")).toBool()
+        || m_pairing.value(QStringLiteral("uncertain")).toBool()) return;
+    const auto device = deviceArgument(m_pairing.value(QStringLiteral("address")).toString());
+    const auto kind = m_pairing.value(QStringLiteral("kind")).toString();
+    QString method;
+    QVariantList args{device, true};
+    if (kind == QStringLiteral("pin")) {
+        const auto bytes = pin.toUtf8();
+        if (bytes.size() < m_pairing.value(QStringLiteral("minimum")).toInt() || bytes.size() > 16) {
+            fail(i18n("Enter a PIN of the requested length, at most 16 bytes.")); return;
+        }
+        method = QStringLiteral("SetPin");
+        args.append(bytes);
+    } else if (kind == QStringLiteral("passkey")) {
+        if (!QRegularExpression(QStringLiteral("^[0-9]{6}$")).match(pin).hasMatch()) {
+            fail(i18n("Enter a six-digit passkey.")); return;
+        }
+        const quint32 value = pin.toUInt();
+        // Floss's Linux SetPasskey expects exactly four native-endian bytes.
+        QByteArray bytes(4, '\0');
+        std::memcpy(bytes.data(), &value, sizeof(value));
+        method = QStringLiteral("SetPasskey");
+        args.append(bytes);
+    } else if (kind == QStringLiteral("confirm")) {
+        method = QStringLiteral("SetPairingConfirmation");
+    } else if (kind == QStringLiteral("display")) {
+        // Retain notification identity and cancellation until the bond completes.
+        m_pairing.insert(QStringLiteral("answered"), true);
+        Q_EMIT pairingChanged();
+        return;
+    } else return;
+    m_pairing.insert(QStringLiteral("pending"), true);
+    Q_EMIT pairingChanged();
+    call(method, args, [this, token](const QDBusMessage &reply) {
+        if (m_pairing.value(QStringLiteral("token")).toString() != token) return;
+        m_pairing.insert(QStringLiteral("pending"), false);
+        const bool accepted = reply.type() != QDBusMessage::ErrorMessage && reply.arguments().value(0).toBool();
+        m_pairing.insert(QStringLiteral("answered"), accepted);
+        m_pairing.insert(QStringLiteral("uncertain"), reply.type() == QDBusMessage::ErrorMessage);
+        if (!accepted) fail(reply.type() == QDBusMessage::ErrorMessage
+            ? i18n("The pairing response could not be confirmed. Cancel pairing before trying again.")
+            : i18n("Floss rejected the pairing response. Retry or cancel pairing."));
+        Q_EMIT pairingChanged();
+        if (m_pairing.value(QStringLiteral("cancelRequested")).toBool() || m_pairing.value(QStringLiteral("expired")).toBool()) cancelPairing(token);
+    }, false);
+}
+
+void FlossBackend::callback(const QDBusMessage &message)
+{
+    if (message.interface() == QStringLiteral("org.chromium.bluetooth.BatteryManagerCallback")) {
+        batteryCallback(message);
+        return;
+    }
+    const auto args = message.arguments();
+    const auto member = message.member();
+    const auto signature = message.signature();
+    if ((member == QStringLiteral("OnDeviceFound") && signature == QStringLiteral("a{sv}"))
+        || (member == QStringLiteral("OnDevicePropertiesChanged") && signature == QStringLiteral("a{sv}au"))) {
+        readDevice(map(args[0]));
+    } else if (member == QStringLiteral("OnDeviceCleared") && signature == QStringLiteral("a{sv}")) {
+        const auto address = map(args[0]).value(QStringLiteral("address")).toString();
+        ++m_deviceRevisions[address];
+        m_devices.remove(address);
+        ++m_batteryRevisions[address];
+        ++m_aliasRevisions[address];
+        m_aliasRequests.remove(address);
+        m_operations.remove(address);
+        clearPairing(address);
+    } else if (member == QStringLiteral("OnDiscoveringChanged") && signature == QStringLiteral("b")) {
+        m_discovering = args[0].toBool();
+    } else if (member == QStringLiteral("OnBondStateChanged") && signature == QStringLiteral("usu")) {
+        const auto address = args[1].toString();
+        ++m_deviceRevisions[address];
+        if (!m_devices.contains(address)) readDevice({{QStringLiteral("address"), address}, {QStringLiteral("name"), address}});
+        m_devices[address].insert(QStringLiteral("paired"), args[2].toUInt() == 2);
+        if (args[2].toUInt() != 1) {
+            const bool connectAfterBond = args[2].toUInt() == 2 && args[0].toUInt() == 0
+                && m_devices[address].value(QStringLiteral("pending")).toString() == QStringLiteral("pair");
+            finish(address, QStringLiteral("pair"), args[2].toUInt() == 2 && args[0].toUInt() == 0 ? QString() : i18n("Pairing failed (status %1).", args[0].toUInt()));
+            if (args[2].toUInt() == 0) finish(address, QStringLiteral("forget"));
+            clearPairing(address);
+            if (connectAfterBond) operate(address, QStringLiteral("connect"));
+        }
+    } else if ((member == QStringLiteral("OnDeviceConnected") || member == QStringLiteral("OnDeviceDisconnected")) && signature == QStringLiteral("a{sv}")) {
+        const auto device = map(args[0]);
+        const auto address = device.value(QStringLiteral("address")).toString();
+        ++m_deviceRevisions[address];
+        if (!m_devices.contains(address)) readDevice(device);
+        const bool connected = member == QStringLiteral("OnDeviceConnected");
+        m_devices[address].insert(QStringLiteral("connected"), connected);
+        if (!connected) {
+            m_devices[address].remove(QStringLiteral("profileRequest"));
+            m_devices[address].remove(QStringLiteral("batteries"));
+            m_devices[address].remove(QStringLiteral("batteryText"));
+            ++m_batteryRevisions[address];
+        } else {
+            readDeviceDetails(address);
+        }
+    } else if (member == QStringLiteral("OnDeviceConnectionFailed") && signature == QStringLiteral("a{sv}u")) {
+        const auto address = map(args[0]).value(QStringLiteral("address")).toString();
+        finish(address, QStringLiteral("connect"));
+        if (m_devices.contains(address)) m_devices[address].remove(QStringLiteral("profileRequest"));
+        if (!m_reconnect || !m_reconnect->isAutomaticAttempt(address)) {
+            fail(i18n("Connection to %1 failed (status %2).", address, args[1].toUInt()));
+        }
+    } else if (member == QStringLiteral("OnSspRequest") && signature == QStringLiteral("a{sv}uuu")) {
+        const uint variant = args[2].toUInt();
+        const QString code = QStringLiteral("%1").arg(args[3].toUInt(), 6, 10, QLatin1Char('0'));
+        if (variant == 0) prompt(map(args[0]), QStringLiteral("confirm"), code);
+        else if (variant == 1) prompt(map(args[0]), QStringLiteral("passkey"), {});
+        else if (variant == 3) prompt(map(args[0]), QStringLiteral("display"), code);
+        // Consent (2) is already answered by Floss's active-pairing policy.
+    } else if (member == QStringLiteral("OnPinRequest") && signature == QStringLiteral("a{sv}ub")) {
+        prompt(map(args[0]), QStringLiteral("pin"), {}, args[2].toBool() ? 16 : 1);
+    } else if (member == QStringLiteral("OnPinDisplay") && signature == QStringLiteral("a{sv}s")) {
+        prompt(map(args[0]), QStringLiteral("display"), args[1].toString());
+    }
+    Q_EMIT changed();
+}
+
