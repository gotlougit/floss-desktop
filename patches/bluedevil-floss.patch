-
-    if (m_obexdServiceError != BluezQt::PendingCall::NoError) {
-        setErrorMessage(i18nc("@info:status %1 error message", "Failed to start org.bluez.obex service: %1", call->errorText()));
-    }
-
-    Q_EMIT obexServiceInitialized();
