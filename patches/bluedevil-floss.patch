+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "flossbackend.h"
+
+#include <QDBusArgument>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusObjectPath>
+#include <QDBusPendingCallWatcher>
+#include <KLocalizedString>
+
+namespace {
+using BatteryList = QList<QVariantMap>;
+const QString batteryInterface = QStringLiteral("org.chromium.bluetooth.BatteryManager");
+}
+
+void FlossBackend::batteryCall(const QString &method, const QVariantList &args,
+                              std::function<void(const QDBusMessage &)> done)
+{
+    if (m_owner.isEmpty()) return;
+    auto message = QDBusMessage::createMethodCall(m_owner,
+        QStringLiteral("/org/chromium/bluetooth/hci%1/battery_manager").arg(m_adapter), batteryInterface, method);
+    message.setArguments(args);
+    const auto epoch = m_epoch;
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(message, 5000), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, watcher, epoch, done]() {
+        const auto reply = watcher->reply();
+        watcher->deleteLater();
+        if (epoch == m_epoch && done) done(reply);
+    });
+}
+
+void FlossBackend::initializeDeviceDetails()
+{
+    if (!m_ready || m_batteryRegistered || m_batteryInitializing) return;
+    m_batteryInitializing = true;
+    batteryCall(QStringLiteral("RegisterBatteryCallback"), {QVariant::fromValue(QDBusObjectPath(m_callbackPath))},
+        [this](const QDBusMessage &reply) {
+            m_batteryInitializing = false;
+            if (reply.type() == QDBusMessage::ErrorMessage || reply.signature() != QStringLiteral("u")) return;
+            m_batteryCallbackId = reply.arguments().first().toUInt();
+            m_batteryRegistered = true;
+            // Register before snapshotting so a newer callback wins over a read.
+            for (const auto &address : m_devices.keys()) readDeviceDetails(address);
+        });
+}
+
+void FlossBackend::resetDeviceDetails()
+{
+    m_batteryRegistered = m_batteryInitializing = false;
+    m_batteryRevisions.clear();
+    m_aliasRequests.clear();
+    m_aliasRevisions.clear();
+}
+
+void FlossBackend::unregisterDeviceDetails()
+{
+    if (m_batteryRegistered) batteryCall(QStringLiteral("UnregisterBatteryCallback"), {m_batteryCallbackId});
+}
+
+void FlossBackend::readDeviceDetails(const QString &address)
+{
+    if (!m_devices.contains(address)) return;
+    const auto revision = ++m_aliasRevisions[address];
+    if (!m_aliasRequests.contains(address)) call(QStringLiteral("GetRemoteAlias"), {deviceArgument(address)}, [this, address, revision](const QDBusMessage &reply) {
+        if (reply.type() == QDBusMessage::ErrorMessage || reply.signature() != QStringLiteral("s")
+            || !m_devices.contains(address) || revision != m_aliasRevisions.value(address)) return;
+        m_devices[address].insert(QStringLiteral("alias"), reply.arguments().first().toString());
+        Q_EMIT changed();
+    }, false);
+    if (!m_batteryRegistered || !m_devices[address].value(QStringLiteral("connected")).toBool()) return;
+    const auto batteryRevision = ++m_batteryRevisions[address];
+    batteryCall(QStringLiteral("GetBatteryInformation"), {address}, [this, address, batteryRevision](const QDBusMessage &reply) {
+        if (reply.type() == QDBusMessage::ErrorMessage || reply.signature() != QStringLiteral("a{sv}")
+            || batteryRevision != m_batteryRevisions.value(address)) return;
+        // dbus_projection represents Option<T> as an optional_value propmap.
+        const auto optional = qdbus_cast<QVariantMap>(reply.arguments().first());
+        updateBattery(address, qdbus_cast<QVariantMap>(optional.value(QStringLiteral("optional_value"))));
+    });
+}
+
+void FlossBackend::updateBattery(const QString &address, const QVariantMap &batterySet)
+{
+    if (!m_devices.contains(address) || !m_devices[address].value(QStringLiteral("connected")).toBool()) return;
+    if (!batterySet.isEmpty() && batterySet.value(QStringLiteral("address")).toString() != address) return;
+    QVariantList batteries;
+    QStringList descriptions;
+    const auto entries = qdbus_cast<BatteryList>(batterySet.value(QStringLiteral("batteries")));
+    for (const auto &entry : entries) {
+        bool valid = false;
+        const uint percentage = entry.value(QStringLiteral("percentage")).toUInt(&valid);
+        if (!valid || percentage > 100) continue;
+        const auto variant = entry.value(QStringLiteral("variant")).toString();
+        batteries.append(QVariantMap{{QStringLiteral("percentage"), percentage}, {QStringLiteral("variant"), variant}});
+        descriptions.append(variant.isEmpty() ? i18n("%1%", percentage) : i18n("%1: %2%", variant, percentage));
+    }
+    m_devices[address].insert(QStringLiteral("batteries"), batteries);
+    m_devices[address].insert(QStringLiteral("batteryText"), descriptions.join(QStringLiteral(", ")));
+    Q_EMIT changed();
+}
+
+void FlossBackend::batteryCallback(const QDBusMessage &message)
+{
+    if (message.member() != QStringLiteral("OnBatteryInfoUpdated") || message.signature() != QStringLiteral("sa{sv}")) return;
+    const auto address = message.arguments().first().toString();
+    if (!m_devices.contains(address)) return;
+    ++m_batteryRevisions[address];
+    updateBattery(address, qdbus_cast<QVariantMap>(message.arguments().at(1)));
+}
+
+void FlossBackend::setAlias(const QString &address, const QString &alias)
+{
+    if (!m_ready || !m_devices.contains(address) || m_aliasRequests.contains(address)) return;
+    if (alias.toUtf8().size() > 248 || alias.contains(QChar::Null)) {
+        fail(i18n("The device name must be at most 248 bytes and contain no null characters."));
+        return;
+    }
+    const auto request = ++m_serial;
+    ++m_aliasRevisions[address];
+    m_aliasRequests[address] = request;
+    m_devices[address].insert(QStringLiteral("aliasPending"), true);
+    Q_EMIT changed();
+    call(QStringLiteral("SetRemoteAlias"), {deviceArgument(address), alias}, [this, address, alias, request](const QDBusMessage &reply) {
+        if (m_aliasRequests.value(address) != request) return;
+        if (reply.type() == QDBusMessage::ErrorMessage) {
+            m_aliasRequests.remove(address);
+            if (m_devices.contains(address)) m_devices[address].remove(QStringLiteral("aliasPending"));
+            fail(reply.errorMessage());
+            return;
+        }
+        // The setter returns void even if native mutation fails. Confirm state.
+        confirmAlias(address, alias, request, 10);
+    }, false);
+}
+
+void FlossBackend::confirmAlias(const QString &address, const QString &alias, quint64 request, int attempts)
+{
+    if (m_aliasRequests.value(address) != request || !m_devices.contains(address)) return;
+    call(QStringLiteral("GetRemoteAlias"), {deviceArgument(address)}, [this, address, alias, request, attempts](const QDBusMessage &reply) {
+        if (m_aliasRequests.value(address) != request || !m_devices.contains(address)) return;
+        const bool confirmed = reply.type() != QDBusMessage::ErrorMessage && reply.signature() == QStringLiteral("s")
+            && reply.arguments().first().toString() == alias;
+        if (confirmed || attempts <= 1 || reply.type() == QDBusMessage::ErrorMessage) {
+            m_aliasRequests.remove(address);
+            m_devices[address].remove(QStringLiteral("aliasPending"));
+            if (confirmed) m_devices[address].insert(QStringLiteral("alias"), alias);
+            else fail(i18n("Floss did not confirm the new device name."));
+            Q_EMIT changed();
+            return;
+        }
+        const auto epoch = m_epoch;
+        QTimer::singleShot(300, this, [this, address, alias, request, attempts, epoch]() {
+            if (epoch == m_epoch) confirmAlias(address, alias, request, attempts - 1);
+        });
+    }, false);
+}
