diff --git a/src/floss/flossreconnect.cpp b/src/floss/flossreconnect.cpp
new file mode 100644
index 00000000..f9c20655
--- /dev/null
+++ b/src/floss/flossreconnect.cpp
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "flossreconnect.h"
+#include "flossbackend.h"
+
+#include <QDateTime>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusServiceWatcher>
+#include <QStandardPaths>
+#include <QUuid>
+#include <algorithm>
+
+namespace {
+constexpr qint64 initialDelay = 5000;
+constexpr qint64 connectionTimeout = 30000;
+constexpr qint64 disconnectReconciliation = 45000;
+constexpr qint64 maximumDelay = 300000;
+QString settingsFile()
+{
+    return QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation)
+        + QStringLiteral("/bluedevil-floss-reconnect.ini");
+}
+}
+
+FlossReconnect::FlossReconnect(FlossBackend *backend)
+    : QObject(backend), m_backend(backend), m_settings(settingsFile(), QSettings::IniFormat)
+{
+    m_service = QStringLiteral("org.kde.bluedevil.FlossReconnect.hci%1").arg(backend->m_adapter);
+    m_connection = QStringLiteral("bluedevil-reconnect-%1").arg(QUuid::createUuid().toString(QUuid::Id128));
+    const auto bus = QDBusConnection::connectToBus(QDBusConnection::SessionBus, m_connection);
+    auto *watcher = new QDBusServiceWatcher(m_service, bus, QDBusServiceWatcher::WatchForUnregistration, this);
+    connect(watcher, &QDBusServiceWatcher::serviceUnregistered, this, [this]() { acquire(); });
+    acquire();
+    m_timer.setInterval(1000);
+    connect(&m_timer, &QTimer::timeout, this, [this]() { tick(); });
+    m_timer.start();
+}
+
+FlossReconnect::~FlossReconnect()
+{
+    if (m_owner) QDBusConnection(m_connection).unregisterService(m_service);
+    QDBusConnection::disconnectFromBus(m_connection);
+}
+
+void FlossReconnect::acquire()
+{
+    if (!m_owner) m_owner = QDBusConnection(m_connection).registerService(m_service);
+}
+
+QString FlossReconnect::key(const QString &address, const QString &setting) const
+{
+    return QStringLiteral("hci%1/%2/%3").arg(m_backend->m_adapter).arg(address.toUpper(), setting);
+}
+
+bool FlossReconnect::userOperation(const QString &address, const QString &operation)
+{
+    const bool inhibit = operation == QStringLiteral("disconnect") || operation == QStringLiteral("forget");
+    // Commit intent before sending a D-Bus request. Other UI processes and a
+    // restarted policy worker must never turn an explicit disconnect into a retry.
+    m_settings.sync();
+    const auto now = QDateTime::currentMSecsSinceEpoch();
+    m_settings.setValue(key(address, QStringLiteral("inhibited")), inhibit);
+    m_settings.setValue(key(address, QStringLiteral("autoAttempt")), false);
+    m_settings.setValue(key(address, QStringLiteral("disconnectUntil")), inhibit ? now + disconnectReconciliation : 0);
+    m_settings.setValue(key(address, QStringLiteral("nextDisconnect")), now + initialDelay);
+    m_settings.setValue(key(address, QStringLiteral("failures")), 0);
+    m_settings.setValue(key(address, QStringLiteral("nextAttempt")), QDateTime::currentMSecsSinceEpoch() + connectionTimeout);
+    m_settings.sync();
+    if (m_settings.status() != QSettings::NoError) {
+        m_backend->fail(QStringLiteral("Could not save Bluetooth reconnect preferences."));
+        return false;
+    }
+    return true;
+}
+
+bool FlossReconnect::isAutomaticAttempt(const QString &address)
+{
+    // A callback is broadcast to every desktop client. Persist the request
+    // origin so observers suppress routine retry failures too. Explicit intent
+    // resets it before its request is sent, preserving actionable UI errors.
+    m_settings.sync();
+    return m_settings.status() == QSettings::NoError
+        && m_settings.value(key(address, QStringLiteral("autoAttempt")), false).toBool();
+}
+
+void FlossReconnect::tick()
+{
+    if (!m_owner) { acquire(); return; }
+    if (m_epoch != m_backend->m_epoch) {
+        m_epoch = m_backend->m_epoch;
+        m_pending.clear();
+        m_disconnecting = false;
+        ++m_request;
+    }
+    if (!m_backend->m_ready) return;
+    m_settings.sync();
+    // A storage failure must not accidentally disregard a saved inhibition.
+    if (m_settings.status() != QSettings::NoError) return;
+    const auto now = QDateTime::currentMSecsSinceEpoch();
+    if (!m_pending.isEmpty()) {
+        const auto device = m_backend->m_devices.value(m_pending);
+        if (device.value(QStringLiteral("connected")).toBool()
+            || !device.value(QStringLiteral("paired")).toBool()
+            || m_settings.value(key(m_pending, QStringLiteral("inhibited")), false).toBool()
+            || now >= m_pendingUntil) {
+            m_pending.clear();
+            ++m_request;
+        }
+    }
+    if (m_disconnecting) return;
+    // Native profile connection work can complete after a UI's disconnect was
+    // acknowledged. Reconcile that race for a bounded window after explicit
+    // intent, including across worker restart. Inhibition alone is not blocking:
+    // a later connection initiated at the remote device remains permitted.
+    for (auto it = m_backend->m_devices.cbegin(); it != m_backend->m_devices.cend(); ++it) {
+        const auto &address = it.key();
+        const auto until = m_settings.value(key(address, QStringLiteral("disconnectUntil"))).toLongLong();
+        if (!it.value().value(QStringLiteral("connected")).toBool()
+            || !m_settings.value(key(address, QStringLiteral("inhibited")), false).toBool()
+            || until <= now || until > now + disconnectReconciliation
+            || m_settings.value(key(address, QStringLiteral("nextDisconnect"))).toLongLong() > now) continue;
+        m_settings.setValue(key(address, QStringLiteral("nextDisconnect")), now + initialDelay);
+        m_settings.sync();
+        if (m_settings.status() != QSettings::NoError
+            || !m_settings.value(key(address, QStringLiteral("inhibited")), false).toBool()
+            || m_settings.value(key(address, QStringLiteral("disconnectUntil"))).toLongLong() <= now) return;
+        m_disconnecting = true;
+        m_backend->call(QStringLiteral("DisconnectAllEnabledProfiles"), {m_backend->deviceArgument(address)},
+            [this](const QDBusMessage &) { m_disconnecting = false; }, false);
+        return;
+    }
+    if (!m_pending.isEmpty()) {
+        if (now - m_lastProbe >= 5000) {
+            m_lastProbe = now;
+            m_backend->readDevice(m_backend->deviceArgument(m_pending));
+        }
+        return;
+    }
+
+    QString candidate;
+    qint64 earliest = now + 1;
+    for (auto it = m_backend->m_devices.cbegin(); it != m_backend->m_devices.cend(); ++it) {
+        const auto &address = it.key();
+        const auto &device = it.value();
+        if (!device.value(QStringLiteral("paired")).toBool()
+            || !device.contains(QStringLiteral("connected"))
+            || m_backend->m_operations.contains(address)
+            || m_settings.value(key(address, QStringLiteral("inhibited")), false).toBool()) continue;
+        if (device.value(QStringLiteral("connected")).toBool()) {
+            // Only an observed ACL connection resets failure backoff. Acceptance
+            // of ConnectAllEnabledProfiles does not establish profile readiness.
+            if (m_settings.value(key(address, QStringLiteral("nextAttempt"))).toLongLong() != 0) {
+                m_settings.setValue(key(address, QStringLiteral("failures")), 0);
+                m_settings.setValue(key(address, QStringLiteral("nextAttempt")), 0);
+            }
+            continue;
+        }
+        auto due = m_settings.value(key(address, QStringLiteral("nextAttempt"))).toLongLong();
+        if (due <= 0 || due > now + maximumDelay + connectionTimeout) {
+            due = now + initialDelay;
+            m_settings.setValue(key(address, QStringLiteral("nextAttempt")), due);
+        }
+        if (due < earliest) { earliest = due; candidate = address; }
+    }
+    m_settings.sync();
+    if (candidate.isEmpty() || m_settings.status() != QSettings::NoError) return;
+
+    // Re-read shared state immediately before reserving an attempt. Persist the
+    // deadline before sending it, so owner handoff/crash cannot create a storm.
+    m_settings.sync();
+    if (m_settings.value(key(candidate, QStringLiteral("inhibited")), false).toBool()) return;
+    const int failures = std::clamp(m_settings.value(key(candidate, QStringLiteral("failures")), 0).toInt(), 0, 6);
+    const qint64 delay = std::min(maximumDelay, initialDelay * (qint64(1) << failures));
+    m_settings.setValue(key(candidate, QStringLiteral("failures")), failures + 1);
+    m_settings.setValue(key(candidate, QStringLiteral("autoAttempt")), true);
+    const auto deadline = now + connectionTimeout + delay;
+    m_settings.setValue(key(candidate, QStringLiteral("nextAttempt")), deadline);
+    m_settings.sync();
+    if (m_settings.status() != QSettings::NoError) return;
+    m_pending = candidate;
+    m_lastProbe = now;
+    m_pendingUntil = now + connectionTimeout;
+    const auto request = ++m_request;
+    m_backend->call(QStringLiteral("ConnectAllEnabledProfiles"), {m_backend->deviceArgument(candidate)},
+        [this, candidate, request, delay, deadline](const QDBusMessage &reply) {
+            if (request != m_request) return;
+            const bool accepted = reply.type() != QDBusMessage::ErrorMessage
+                && reply.signature() == QStringLiteral("u") && reply.arguments().value(0).toUInt() == 0;
+            if (!accepted) {
+                m_pending.clear();
+                m_settings.sync();
+                // Do not overwrite a newer explicit operation in another UI.
+                if (!m_settings.value(key(candidate, QStringLiteral("inhibited")), false).toBool()
+                    && m_settings.value(key(candidate, QStringLiteral("nextAttempt"))).toLongLong() == deadline) {
+                    m_settings.setValue(key(candidate, QStringLiteral("nextAttempt")), QDateTime::currentMSecsSinceEpoch() + delay);
+                    m_settings.sync();
+                }
+                return;
+            }
+            // Refresh actual state as well as listening for callbacks. Keep the
+            // attempt outstanding if this snapshot still reports disconnected.
+            m_backend->readDevice(m_backend->deviceArgument(candidate));
+        }, false);
+}
diff --git a/src/floss/flossreconnect.h b/src/floss/flossreconnect.h
new file mode 100644
index 00000000..6142f31f
--- /dev/null
+++ b/src/floss/flossreconnect.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <QObject>
+#include <QSettings>
+#include <QTimer>
+
+class FlossBackend;
+
+// Desktop reconnect policy; Floss owns bonds and all connection procedures.
+// Every UI can host this helper, but a session-bus name elects just one worker.
+class FlossReconnect : public QObject
+{
+public:
+    explicit FlossReconnect(FlossBackend *backend);
+    ~FlossReconnect() override;
+    bool userOperation(const QString &address, const QString &operation);
+    bool isAutomaticAttempt(const QString &address);
+
+private:
+    void tick();
+    void acquire();
+    QString key(const QString &address, const QString &setting) const;
+    FlossBackend *m_backend;
+    QSettings m_settings;
+    QTimer m_timer;
+    QString m_connection;
+    QString m_service;
+    QString m_pending;
+    qint64 m_pendingUntil = 0;
+    qint64 m_lastProbe = 0;
+    quint64 m_epoch = 0;
+    quint64 m_request = 0;
+    bool m_owner = false;
+    bool m_disconnecting = false;
+};
diff --git a/src/floss/flossrfkill.cpp b/src/floss/flossrfkill.cpp
new file mode 100644
index 00000000..534cc9b2
--- /dev/null
+++ b/src/floss/flossrfkill.cpp
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "flossbackend.h"
+#include <QDBusArgument>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <KLocalizedString>
+
+QString FlossBackend::radioMessage() const
+{
+    if (m_hardBlocked) return i18n("Bluetooth is blocked by a hardware switch. Turn the switch on to enable Bluetooth.");
+    if (m_softBlocked) return i18n("Bluetooth is blocked by software. Enable Bluetooth to unblock this adapter.");
+    return {};
+}
+
+void FlossBackend::managerCall(const QString &method, const QVariantList &args,
+                               std::function<void(const QDBusMessage &)> done)
+{
+    auto message = QDBusMessage::createMethodCall(QStringLiteral("org.chromium.bluetooth.Manager"),
+        QStringLiteral("/org/chromium/bluetooth/Manager"), QStringLiteral("org.chromium.bluetooth.Manager"), method);
+    message.setArguments(args);
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(message, 5000), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [watcher, done]() {
+        const auto reply = watcher->reply();
+        watcher->deleteLater();
+        if (done) done(reply);
+    });
+}
+
+bool FlossBackend::readRadioState(const QDBusMessage &reply)
+{
+    if (reply.type() == QDBusMessage::ErrorMessage || reply.signature() != QStringLiteral("a{sv}")) return false;
+    const auto state = qdbus_cast<QVariantMap>(reply.arguments().value(0));
+    for (const auto &key : {QStringLiteral("available"), QStringLiteral("hard_blocked"), QStringLiteral("soft_blocked")}) {
+        if (state.value(key).metaType().id() != QMetaType::Bool) return false;
+    }
+    m_radioAvailable = state.value(QStringLiteral("available")).toBool();
+    m_hardBlocked = m_radioAvailable && state.value(QStringLiteral("hard_blocked")).toBool();
+    m_softBlocked = m_radioAvailable && state.value(QStringLiteral("soft_blocked")).toBool();
+    Q_EMIT changed();
+    return true;
+}
+
+void FlossBackend::refreshRadioState()
+{
+    if (m_powerPending || m_radioReading) return;
+    m_radioReading = true;
+    const auto revision = ++m_radioRevision;
+    managerCall(QStringLiteral("GetRfkillState"), {m_adapter}, [this, revision](const QDBusMessage &reply) {
+        m_radioReading = false;
+        if (revision != m_radioRevision) return;
+        if (!readRadioState(reply)) {
+            m_radioAvailable = m_hardBlocked = m_softBlocked = false;
+            Q_EMIT changed();
+        }
+    });
+}
+
+void FlossBackend::setPowered(bool enabled)
+{
+    if (m_powerPending) return;
+    ++m_radioRevision; // Ignore a polling read started before this user request.
+    m_powerPending = true;
+    m_error.clear();
+    Q_EMIT changed();
+    if (!enabled) { requestManagerPower(false); return; }
+    managerCall(QStringLiteral("GetRfkillState"), {m_adapter}, [this](const QDBusMessage &reply) {
+        if (!readRadioState(reply)) {
+            m_powerPending = false;
+            fail(i18n("Could not determine the Bluetooth radio block state."));
+        } else if (m_hardBlocked) {
+            m_powerPending = false;
+            fail(radioMessage());
+        } else if (!m_softBlocked) {
+            requestManagerPower(true);
+        } else {
+            managerCall(QStringLiteral("SetRfkillBlocked"), {m_adapter, false}, [this](const QDBusMessage &unblock) {
+                if (unblock.type() == QDBusMessage::ErrorMessage || unblock.signature() != QStringLiteral("b")
+                    || !unblock.arguments().value(0).toBool()) {
+                    m_powerPending = false;
+                    fail(i18n("Could not unblock the Bluetooth adapter."));
+                    refreshRadioState();
+                } else {
+                    confirmRadioUnblocked(10);
+                }
+            });
+        }
+    });
+}
+
+void FlossBackend::confirmRadioUnblocked(int attempts)
+{
+    managerCall(QStringLiteral("GetRfkillState"), {m_adapter}, [this, attempts](const QDBusMessage &reply) {
+        if (!readRadioState(reply) || !m_radioAvailable || m_hardBlocked) {
+            m_powerPending = false;
+            fail(i18n("Could not confirm that the Bluetooth adapter is unblocked."));
+        } else if (!m_softBlocked) {
+            requestManagerPower(true);
+        } else if (attempts <= 1) {
+            m_powerPending = false;
+            fail(i18n("The Bluetooth adapter is still blocked."));
+        } else {
+            QTimer::singleShot(200, this, [this, attempts]() { confirmRadioUnblocked(attempts - 1); });
+        }
+    });
+}
+
+void FlossBackend::requestManagerPower(bool enabled)
+{
+    managerCall(enabled ? QStringLiteral("Start") : QStringLiteral("Stop"), {m_adapter}, [this](const QDBusMessage &reply) {
+        m_powerPending = false;
+        if (reply.type() == QDBusMessage::ErrorMessage) fail(reply.errorMessage());
+        Q_EMIT changed();
+        refreshRadioState();
+    });
+}
diff --git a/src/floss/pairingagent.cpp b/src/floss/pairingagent.cpp
new file mode 100644
index 00000000..8661bf5d
--- /dev/null
+++ b/src/floss/pairingagent.cpp
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <QCommandLineParser>
+#include <QGuiApplication>
+#include <QQmlApplicationEngine>
+
+#include <KLocalizedQmlContext>
+#include <KLocalizedString>
+
+#include "version.h"
+
+int main(int argc, char **argv)
+{
+    QGuiApplication application(argc, argv);
+    QCoreApplication::setApplicationName(QStringLiteral("bluedevil-floss-pairing"));
+    QCoreApplication::setApplicationVersion(QStringLiteral(BLUEDEVIL_VERSION_STRING));
+    QCoreApplication::setOrganizationDomain(QStringLiteral("kde.org"));
+    KLocalizedString::setApplicationDomain("bluedevil");
+    QGuiApplication::setApplicationDisplayName(i18n("Bluetooth Pairing"));
+    QGuiApplication::setDesktopFileName(QStringLiteral("org.kde.bluedevil"));
+
+    QCommandLineParser parser;
+    parser.setApplicationDescription(i18n("Handle Bluetooth pairing requests through Floss."));
+    parser.addHelpOption();
+    parser.addVersionOption();
+    parser.process(application);
+
+    // PairingWindow is normally hidden, and closing a prompt must not stop
+    // handling future requests. Its existing backend elects the sole responder
+    // alongside any tray or settings windows already observing the daemon.
+    application.setQuitOnLastWindowClosed(false);
+    QQmlApplicationEngine engine;
+    KLocalization::setupLocalizedContext(&engine);
+    QObject::connect(&engine, &QQmlApplicationEngine::objectCreationFailed,
+                     &application, []() { QCoreApplication::exit(1); }, Qt::QueuedConnection);
+    engine.loadFromModule(QStringLiteral("org.kde.bluedevil.floss"), QStringLiteral("PairingWindow"));
+    return application.exec();
+}
