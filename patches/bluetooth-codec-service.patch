+TEST(A2dpVendorMmcEncoderTest, LdacReportsFramesAndEnforcesPackedPcmSize) {
+  ConfigParam config;
+  auto* param = config.mutable_a2dp_ldac_encoder_param();
+  param->set_sample_rate(96000);
+  param->set_channel_mode(1);  // LDACBT_CHANNEL_MODE_STEREO
+  param->set_pcm_format(3);    // LDACBT_SMPL_FMT_S24
+  param->set_quality_mode(1);  // LDACBT_EQMID_SQ
+  param->set_effective_frame_size(679);
+  A2dpLdacEncoder encoder;
+  ASSERT_EQ(768, encoder.init(config));
+  std::array<uint8_t, 768> pcm{};
+  for (size_t i = 0; i < pcm.size(); ++i) pcm[i] = static_cast<uint8_t>(i * 13);
+  std::array<uint8_t, 1025> encoded{};
+  EXPECT_EQ(-ENOSPC, encoder.transcode(pcm.data(), pcm.size(), encoded.data(), 1024));
+  int written = 0;
+  for (int i = 0; i < 16 && written <= 1; ++i) {
+    written = encoder.transcode(pcm.data(), pcm.size(), encoded.data(), encoded.size());
+  }
+  ASSERT_GT(written, 1);
+  EXPECT_GT(encoded[0], 0);  // transport frames represented by the payload
+  EXPECT_EQ(-EINVAL,
+            encoder.transcode(pcm.data(), pcm.size() - 1, encoded.data(), encoded.size()));
+}
