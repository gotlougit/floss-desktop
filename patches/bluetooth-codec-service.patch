+  std::array<uint8_t, 16> pcm{};
+  std::memcpy(pcm.data(), "0123456789012345", pcm.size());
+  std::array<uint8_t, 4> encoded{};
+  EXPECT_EQ(4, encoder.transcode(pcm.data(), pcm.size(), encoded.data(), encoded.size()));
+  EXPECT_EQ((std::array<uint8_t, 4>{0x4b, 0xbf, 0x4b, 0xbf}), encoded);
+  EXPECT_EQ(-EINVAL, encoder.transcode(pcm.data(), 15, encoded.data(), encoded.size()));
+  EXPECT_EQ(-EINVAL, encoder.transcode(pcm.data(), 16, encoded.data(), 3));
+}
+
+TEST(A2dpVendorMmcEncoderTest, AptxHdConsumesFourStereoPackedS24Frames) {
+  ConfigParam config;
+  config.mutable_a2dp_aptx_encoder_param()->set_variant(AptxEncoderParam::kAptxHd);
+  A2dpAptxEncoder encoder;
+  ASSERT_EQ(24, encoder.init(config));
+  std::array<uint8_t, 24> pcm{};
+  std::memcpy(pcm.data(), "012345678901234567890123", pcm.size());
+  std::array<uint8_t, 6> encoded{};
+  EXPECT_EQ(6, encoder.transcode(pcm.data(), pcm.size(), encoded.data(), encoded.size()));
+  EXPECT_EQ((std::array<uint8_t, 6>{0x73, 0xbe, 0xff, 0x73, 0xbe, 0xff}), encoded);
+  EXPECT_EQ(-EINVAL, encoder.transcode(pcm.data(), 23, encoded.data(), encoded.size()));
+  EXPECT_EQ(-EINVAL, encoder.transcode(pcm.data(), 24, encoded.data(), 5));
+}
