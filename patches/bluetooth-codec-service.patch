diff --git a/system/stack/mmc/codec_server/a2dp_vendor_mmc_encoder.cc b/system/stack/mmc/codec_server/a2dp_vendor_mmc_encoder.cc
new file mode 100644
index 0000000..b583622
--- /dev/null
+++ b/system/stack/mmc/codec_server/a2dp_vendor_mmc_encoder.cc
@@ -0,0 +1,166 @@
+/*
+ * Copyright 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+#include "mmc/codec_server/a2dp_vendor_mmc_encoder.h"
+
+#include <bluetooth/log.h>
+#include <errno.h>
+#include <ldacBT.h>
+
+#include <array>
+#include <cstring>
+
+#include "aptXHDbtenc.h"
+#include "aptXbtenc.h"
+#include "mmc/proto/mmc_config.pb.h"
+
+namespace mmc {
+namespace {
+
+constexpr int kAptxPcmBytes = 16;   // four stereo S16 frames
+constexpr int kAptxHdPcmBytes = 24; // four stereo packed-S24 frames
+
+uint32_t ReadS24Le(const uint8_t* p) {
+  return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
+         (static_cast<uint32_t>(static_cast<int8_t>(p[2])) << 16);
+}
+
+}  // namespace
+
+A2dpAptxEncoder::A2dpAptxEncoder() = default;
+A2dpAptxEncoder::~A2dpAptxEncoder() { cleanup(); }
+
+int A2dpAptxEncoder::init(ConfigParam config) {
+  cleanup();
+  if (!config.has_a2dp_aptx_encoder_param()) return -EINVAL;
+  const auto variant = config.a2dp_aptx_encoder_param().variant();
+  if (variant != AptxEncoderParam::kAptxClassic && variant != AptxEncoderParam::kAptxHd) {
+    return -EINVAL;
+  }
+  hd_ = variant == AptxEncoderParam::kAptxHd;
+  const int state_size = hd_ ? SizeofAptxhdbtenc() : SizeofAptxbtenc();
+  if (state_size <= 0) return -EINVAL;
+  state_ = std::calloc(1, static_cast<size_t>(state_size));
+  if (!state_) return -ENOMEM;
+  const int rc = hd_ ? aptxhdbtenc_init(state_, 0) : aptxbtenc_init(state_, 0);
+  if (rc != 0) {
+    cleanup();
+    return -EIO;
+  }
+  return hd_ ? kAptxHdPcmBytes : kAptxPcmBytes;
+}
+
+void A2dpAptxEncoder::cleanup() {
+  std::free(state_);
+  state_ = nullptr;
+}
+
+int A2dpAptxEncoder::transcode(uint8_t* i_buf, int i_len, uint8_t* o_buf, int o_len) {
+  if (!state_ || !i_buf || !o_buf) return -EINVAL;
+  if (!hd_) {
+    if (i_len <= 0 || i_len % kAptxPcmBytes != 0 || o_len < i_len / 4) return -EINVAL;
+    for (int offset = 0; offset < i_len; offset += kAptxPcmBytes) {
+      uint32_t left[4];
+      uint32_t right[4];
+      for (int i = 0; i < 4; ++i) {
+        int16_t l;
+        int16_t r;
+        std::memcpy(&l, i_buf + offset + i * 4, sizeof(l));
+        std::memcpy(&r, i_buf + offset + i * 4 + 2, sizeof(r));
+        left[i] = static_cast<uint16_t>(l);
+        right[i] = static_cast<uint16_t>(r);
+      }
+      uint16_t encoded[2];
+      if (aptxbtenc_encodestereo(state_, left, right, encoded) != 0) return -EIO;
+      const int out = offset / 4;
+      o_buf[out] = encoded[0] >> 8;
+      o_buf[out + 1] = encoded[0];
+      o_buf[out + 2] = encoded[1] >> 8;
+      o_buf[out + 3] = encoded[1];
+    }
+    return i_len / 4;
+  }
+
+  if (i_len <= 0 || i_len % kAptxHdPcmBytes != 0 || o_len < i_len / 4) return -EINVAL;
+  for (int offset = 0; offset < i_len; offset += kAptxHdPcmBytes) {
+    uint32_t left[4];
+    uint32_t right[4];
+    for (int i = 0; i < 4; ++i) {
+      left[i] = ReadS24Le(i_buf + offset + i * 6);
+      right[i] = ReadS24Le(i_buf + offset + i * 6 + 3);
+    }
+    uint32_t encoded[2];
+    if (aptxhdbtenc_encodestereo(state_, left, right, encoded) != 0) return -EIO;
+    const auto* bytes = reinterpret_cast<const uint8_t*>(encoded);
+    const int out = offset / 4;
+    o_buf[out] = bytes[2];
+    o_buf[out + 1] = bytes[1];
+    o_buf[out + 2] = bytes[0];
+    o_buf[out + 3] = bytes[6];
+    o_buf[out + 4] = bytes[5];
+    o_buf[out + 5] = bytes[4];
+  }
+  return i_len / 4;
+}
+
+A2dpLdacEncoder::A2dpLdacEncoder() = default;
+A2dpLdacEncoder::~A2dpLdacEncoder() { cleanup(); }
+
+int A2dpLdacEncoder::init(ConfigParam config) {
+  cleanup();
+  if (!config.has_a2dp_ldac_encoder_param()) return -EINVAL;
+  const auto& p = config.a2dp_ldac_encoder_param();
+  if ((p.sample_rate() != 44100 && p.sample_rate() != 48000 && p.sample_rate() != 88200 &&
+       p.sample_rate() != 96000) ||
+      (p.channel_mode() != LDACBT_CHANNEL_MODE_DUAL_CHANNEL &&
+       p.channel_mode() != LDACBT_CHANNEL_MODE_STEREO) ||
+      (p.pcm_format() != LDACBT_SMPL_FMT_S16 && p.pcm_format() != LDACBT_SMPL_FMT_S24 &&
+       p.pcm_format() != LDACBT_SMPL_FMT_S32) ||
+      p.quality_mode() < LDACBT_EQMID_HQ || p.quality_mode() > LDACBT_EQMID_MQ ||
+      p.effective_frame_size() < 679 || p.effective_frame_size() > 4096) {
+    return -EINVAL;
+  }
+  auto handle = ldacBT_get_handle();
+  if (!handle) return -ENOMEM;
+  handle_ = handle;
+  if (ldacBT_init_handle_encode(handle, p.effective_frame_size() + 12, p.quality_mode(),
+                                p.channel_mode(), static_cast<LDACBT_SMPL_FMT_T>(p.pcm_format()),
+                                p.sample_rate()) != 0) {
+    cleanup();
+    return -EINVAL;
+  }
+  input_frame_size_ = LDACBT_ENC_LSU * 2 * p.pcm_format();
+  return input_frame_size_;
+}
+
+void A2dpLdacEncoder::cleanup() {
+  if (handle_) ldacBT_free_handle(static_cast<HANDLE_LDAC_BT>(handle_));
+  handle_ = nullptr;
+  input_frame_size_ = 0;
+}
+
+int A2dpLdacEncoder::transcode(uint8_t* i_buf, int i_len, uint8_t* o_buf, int o_len) {
+  if (!handle_ || !i_buf || !o_buf || i_len != input_frame_size_) return -EINVAL;
+  // ldacBT_encode() does not take an output capacity. Requiring room for its
+  // documented maximum before calling it prevents both an overwrite and an
+  // unrecoverable encoder-state advance when a caller supplies a short buffer.
+  if (o_len < LDACBT_MAX_NBYTES + 1) return -ENOSPC;
+  std::array<uint8_t, LDACBT_MAX_NBYTES> encoded{};
+  int encoded_pcm = 0;
+  int written = 0;
+  int frames = 0;
+  if (ldacBT_encode(static_cast<HANDLE_LDAC_BT>(handle_), i_buf, &encoded_pcm, encoded.data(),
+                    &written, &frames) != 0 || encoded_pcm != i_len || written < 0 ||
+      written > LDACBT_MAX_NBYTES || frames < 0 || frames > 255) {
+    return -EIO;
+  }
+  o_buf[0] = static_cast<uint8_t>(frames);
+  if (written > 0) std::memcpy(o_buf + 1, encoded.data(), static_cast<size_t>(written));
+  return written + 1;
+}
+
+}  // namespace mmc
