+  param->set_channel_mode(2);
+  param->set_pcm_format(2);
+  param->set_quality_mode(1);
+  param->set_effective_frame_size(679);
+  A2dpLdacEncoder encoder;
+  EXPECT_EQ(-EINVAL, encoder.init(config));
+}
