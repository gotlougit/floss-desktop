+TEST_F(ScoHciWbsTest, WbsDecodeEveryInitialAlignment) {
+  for (size_t packet_size : {24u, 60u, 72u}) {
+    for (size_t prefix = 0; prefix < 60; ++prefix) {
+      SCOPED_TRACE(::testing::Message() << "packet_size=" << packet_size << " prefix=" << prefix);
+      bluetooth::audio::sco::wbs::init(packet_size);
+      std::vector<uint8_t> stream(prefix, 0x55);
+      for (size_t i = 0; i < 80; ++i) {
+        stream.insert(stream.end(), msbc_zero_packet.begin(), msbc_zero_packet.end());
+      }
+      size_t decoded_frames = 0;
+      for (size_t offset = 0; offset + packet_size <= stream.size(); offset += packet_size) {
+        std::vector<uint8_t> packet(stream.begin() + offset, stream.begin() + offset + packet_size);
+        ASSERT_TRUE(bluetooth::audio::sco::wbs::enqueue_packet(packet, false));
+        const uint8_t* decoded = nullptr;
+        while (bluetooth::audio::sco::wbs::decode(&decoded)) {
+          ASSERT_NE(decoded, nullptr);
+          ++decoded_frames;
+        }
+      }
+      int frames = 0;
+      double loss_ratio = 1;
+      ASSERT_TRUE(bluetooth::audio::sco::wbs::fill_plc_stats(&frames, &loss_ratio));
+      EXPECT_GE(decoded_frames, 78u);
+      EXPECT_EQ(loss_ratio, 0);
+      bluetooth::audio::sco::wbs::cleanup();
+    }
+  }
 }
 
