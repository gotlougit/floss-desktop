+A2dpPcmConfig A2dpIntf::get_pcm_config_for_peer(RawAddress addr) const {
+  std::promise<A2dpPcmConfig> result;
+  auto future = result.get_future();
+  if (do_in_main_thread(base::BindOnce(
+      [](RawAddress address, std::promise<A2dpPcmConfig> result) {
+        if (btif_av_source_active_peer() != address || !btif_av_stream_started_ready(A2dpType::kSource)) {
+          result.set_value({});
+          return;
+        }
+        const auto pcm = bluetooth::audio::a2dp::GetPcmConfig();
+        result.set_value(A2dpPcmConfig{pcm.ready, pcm.sample_rate, pcm.bits_per_sample,
+            pcm.channels_count, pcm.generation, "/var/run/bluetooth/audio/.a2dp_data"});
+      }, addr, std::move(result))) != BT_STATUS_SUCCESS) return {};
+  if (future.wait_for(std::chrono::milliseconds(250)) != std::future_status::ready) return {};
+  return future.get();
+}
+
+RustSessionPosition A2dpIntf::get_position_for_peer(RawAddress addr) const {
+  std::promise<RustSessionPosition> result;
+  auto future = result.get_future();
+  if (do_in_main_thread(base::BindOnce(
+      [](RawAddress address, std::promise<RustSessionPosition> result) {
+        if (btif_av_source_active_peer() != address || !btif_av_stream_started_ready(A2dpType::kSource)) {
+          result.set_value({});
+          return;
+        }
+        const auto p = bluetooth::audio::a2dp::GetPresentationPosition();
+        result.set_value(RustSessionPosition{true, RustPresentationPosition{
+            p.remote_delay_report_ns, p.total_bytes_read, p.data_position.tv_sec,
+            static_cast<int32_t>(p.data_position.tv_nsec)}});
+      }, addr, std::move(result))) != BT_STATUS_SUCCESS) return {};
+  if (future.wait_for(std::chrono::milliseconds(250)) != std::future_status::ready) return {};
+  return future.get();
+}
