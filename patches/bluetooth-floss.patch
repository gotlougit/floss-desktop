+bool A2dpIntf::start_audio_for_peer(RawAddress addr) const {
+  if (!btif_av_source_select_audio_peer(addr)) return false;
+  std::promise<bool> result;
+  auto future = result.get_future();
+  if (do_in_main_thread(base::BindOnce([](RawAddress address, std::promise<bool> result) {
+        result.set_value(btif_av_source_active_peer() == address &&
+            bluetooth::audio::a2dp::StartRequest());
+      }, addr, std::move(result))) != BT_STATUS_SUCCESS) return false;
+  // A queued operation may still execute. Retain ownership on timeout so the
+  // client's token cancellation, not a false rejection, settles the session.
+  if (future.wait_for(std::chrono::milliseconds(250)) != std::future_status::ready) return true;
+  return future.get();
+}
+
+bool A2dpIntf::stop_audio_for_peer(RawAddress addr) const {
+  std::promise<bool> result;
+  auto future = result.get_future();
+  if (do_in_main_thread(base::BindOnce([](RawAddress address, std::promise<bool> result) {
+        // A failed pending START has no AudioState callback in legacy native
+        // code. Force an address-scoped profile terminal event in that case.
+        // Never send a global stop to a replacement active peer.
+        if (btif_av_source_active_peer() == address &&
+            btif_av_stream_started_ready(A2dpType::kSource)) {
+          result.set_value(bluetooth::audio::a2dp::StopRequest());
+        } else {
+          result.set_value(btif_av_source_disconnect(address) == BT_STATUS_SUCCESS);
+        }
+      }, addr, std::move(result))) != BT_STATUS_SUCCESS) return false;
+  // A queued operation may still execute. Retain ownership on timeout so the
+  // client's token cancellation, not a false rejection, settles the session.
+  if (future.wait_for(std::chrono::milliseconds(250)) != std::future_status::ready) return true;
+  return future.get();
+}
