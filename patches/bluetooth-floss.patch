+
+// Called by the Floss RPC thread, never the stack main thread. Selection and
+// admission are evaluated together there, before changing the previous peer.
+bool btif_av_source_select_audio_peer(const RawAddress& peer_address) {
+  auto cancelled = std::make_shared<std::atomic<bool>>(false);
+  std::promise<void> ready;
+  auto ready_future = ready.get_future();
+  std::promise<bool> accepted;
+  auto accepted_future = accepted.get_future();
+  if (do_in_main_thread(base::BindOnce(
+          [](std::shared_ptr<std::atomic<bool>> cancelled, RawAddress address,
+             std::promise<void> ready, std::promise<bool> accepted) {
+            if (cancelled->load() || !btif_av_source.Enabled()) {
+              ready.set_value();
+              accepted.set_value(false);
+              return;
+            }
+            // An unleased remote START may race the desktop's reservation.
+            // Adopt only that exact peer; never steal another active stream.
+            if (btif_av_stream_started_ready(A2dpType::kSource)) {
+              ready.set_value();
+              accepted.set_value(btif_av_source_active_peer() == address);
+              return;
+            }
+            accepted.set_value(btif_av_source.SetActivePeer(address, std::move(ready)));
+          }, cancelled, peer_address, std::move(ready), std::move(accepted))) != BT_STATUS_SUCCESS) return false;
+  if (accepted_future.wait_for(std::chrono::seconds(1)) != std::future_status::ready) {
+    cancelled->store(true);
+    return false;  // No START can be issued after failed selection.
+  }
+  const bool result = accepted_future.get();
+  if (ready_future.wait_for(std::chrono::seconds(1)) != std::future_status::ready) return false;
+  return result;
+}
