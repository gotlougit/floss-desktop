-static int do_acquire(struct port *port)
-{
-	struct impl *this = port->impl;
-	const char *method = (port->direction == SPA_DIRECTION_OUTPUT) ?
-		"AcquireNotify" : "AcquireWrite";
-	GVariant *options;
-	GVariantBuilder builder;
-
-	if (port->acquired)
-		return 0;
-	if (port->acquire_call)
-		return 0;
