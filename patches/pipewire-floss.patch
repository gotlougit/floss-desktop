-	if (prev_channels > 0) {
-		size_t i;
-
-		/* Spread mono volume to all channels */
-		for (i = prev_channels; i < this->nodes[id].n_channels; ++i)
-			this->nodes[id].volumes[i] = this->nodes[id].volumes[i % prev_channels];
-	}
