-	}
-
-	bluez5_codec_a2dp = iface;
-
-	if (bluez5_codec_a2dp->iface.version != SPA_VERSION_BLUEZ5_CODEC_MEDIA) {
-		spa_log_warn(impl->log, "codec plugin %s has incompatible ABI version (%d != %d)",
