-	spa_return_val_if_fail(command != NULL, -EINVAL);
-
-	switch (SPA_NODE_COMMAND_ID(command)) {
-	case SPA_NODE_COMMAND_Start:
-		if ((res = do_start(this)) < 0)
-			return res;
-		break;
-	case SPA_NODE_COMMAND_Pause:
-		if ((res = do_stop(this)) < 0)
