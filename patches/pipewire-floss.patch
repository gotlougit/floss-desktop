-	}
-
-	transport = spa_bt_transport_find(monitor, remote_endpoint->transport_path);
-	if (transport != NULL) {
-		spa_log_debug(monitor->log, "transport %p: free %s",
-			transport, transport->path);
-		spa_bt_transport_free(transport);
