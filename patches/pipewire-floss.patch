-static void configure_bcast_source(struct spa_bt_monitor *monitor,
-				struct spa_bt_remote_endpoint *ep,
-				const struct media_codec *codec,
-				DBusConnection *conn,
-				const char *object_path,
-				const char *interface_name,
-				const char *local_endpoint)
