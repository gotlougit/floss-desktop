-					spa_bt_device_connect_profile(rfcomm->device, rfcomm->profile);
-				}
-			}
-		}
-	} else if (sscanf(token, "+VGM%*1[:=]%u", &gain) == 1) {
-		if (gain <= SPA_BT_VOLUME_HS_MAX) {
-			rfcomm_emit_volume_changed(rfcomm, SPA_BT_VOLUME_ID_TX, gain);
