-
-	dbus_message_iter_init(m, &i);
-	dbus_message_iter_next(&i); /* skip name */
-	dbus_message_iter_recurse(&i, &variant); /* value */
-	if (dbus_message_iter_get_arg_type(&variant) != DBUS_TYPE_BYTE)
