-	case SPA_BLUETOOTH_AUDIO_CODEC_CVSD:
-	case SPA_BLUETOOTH_AUDIO_CODEC_MSBC:
-	case SPA_BLUETOOTH_AUDIO_CODEC_LC3_SWB:
