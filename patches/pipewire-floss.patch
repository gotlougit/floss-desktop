-struct spa_bt_iso_io *spa_bt_iso_io_attach(struct spa_bt_iso_io *this, struct spa_bt_transport *t)
-{
-	struct stream *stream = SPA_CONTAINER_OF(this, struct stream, this);
-
-	stream = stream_create(t, stream->group);
-	if (stream == NULL)
-		return NULL;
-
-	return &stream->this;
