-static int do_stop(struct impl *this)
-{
-	int res;
-
-	if (!this->started)
-		return 0;
-
-	spa_log_debug(this->log, "%p: stop", this);
-
-	this->start_ready = false;
-
-	spa_loop_locked(this->data_loop, do_remove_source, 0, NULL, 0, this);
-
-	transport_stop(this);
-
-	if (this->transport)
-		res = spa_bt_transport_release(this->transport);
-	else
-		res = 0;
-
-	this->started = false;
-
-	return res;
