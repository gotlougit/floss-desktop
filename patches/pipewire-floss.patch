-{
-	size_t actual_conf_size = codec_get_caps_size(codec);
-	const a2dp_aptx_t a2dp_aptx = {
-		.info = codec->vendor,
-		.frequency =
-			APTX_SAMPLING_FREQ_16000 |
-			APTX_SAMPLING_FREQ_32000 |
-			APTX_SAMPLING_FREQ_44100 |
-			APTX_SAMPLING_FREQ_48000,
