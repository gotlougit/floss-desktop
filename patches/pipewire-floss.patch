-	};
-	const a2dp_aptx_ll_t a2dp_aptx_ll = {
-		.aptx = a2dp_aptx,
-		.bidirect_link = codec->duplex_codec ? true : false,
-		.has_new_caps = false,
-	};
-	if (codec_is_ll(codec))
-		memcpy(caps, &a2dp_aptx_ll, sizeof(a2dp_aptx_ll));
-	else
-		memcpy(caps, &a2dp_aptx, sizeof(a2dp_aptx));
