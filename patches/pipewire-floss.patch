-	ts.tv_sec = timeout / SPA_NSEC_PER_SEC;
-	ts.tv_nsec = timeout % SPA_NSEC_PER_SEC;
-	spa_loop_utils_update_timer(rfcomm->backend->loop_utils, rfcomm->volume_sync_timer,
