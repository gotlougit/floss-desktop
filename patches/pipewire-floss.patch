-	spa_list_for_each(rfcomm, &backend->rfcomm_list, link) {
-		if (spa_streq(rfcomm->device->address, d->address) &&
-				spa_streq(rfcomm->device->adapter->address, d->adapter->address)) {
-			bool connected = false;
