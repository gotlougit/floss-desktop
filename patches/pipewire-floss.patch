-	}
-
-	if (!is_dyn_node) {
-		uint32_t prev_channels = this->nodes[id].n_channels;
-		float boost;
-
-		this->nodes[id].impl = this;
-		this->nodes[id].active = true;
-		this->nodes[id].offload_acquired = false;
-		this->nodes[id].a2dp_duplex = a2dp_duplex;
