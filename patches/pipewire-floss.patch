-static void activate_timer_event(void *userdata, uint64_t expirations)
-{
-	struct impl *backend = userdata;
-	spa_loop_utils_update_timer(backend->loop_utils, backend->timer, NULL, NULL, false);
-	activate_transports(backend);
-}
