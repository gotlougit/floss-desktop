-
-error_errno:
-	res = -errno;
-	goto error;
-
-error:
-	if (this) {
-		for (ich = 0; ich < this->channels; ich++) {
-			if (this->enc[ich])
-				free(this->enc[ich]);
-			if (this->dec[ich])
-				free(this->dec[ich]);
-		}
-	}
-	free(this);
