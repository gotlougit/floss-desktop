-	.get_block_size = codec_get_block_size,
-	.start_encode = codec_start_encode,
-	.encode = codec_encode,
-	.abr_process = codec_abr_process,
-	.reduce_bitpool = codec_reduce_bitpool,
-	.increase_bitpool = codec_increase_bitpool,
-	.set_log = codec_set_log,
-};
-
