-static uint8_t get_channel_count(uint32_t channels)
-{
-	uint8_t num;
-
-	channels &= BAP_CHANNEL_ALL;
-
-	if (channels == 0)
-		return 1;  /* MONO */
-
-	for (num = 0; channels; channels >>= 1)
-		if (channels & 0x1)
-			++num;
-
-	return num;
-}
-
-static bool supports_channel_count(uint8_t mask, uint8_t count)
-{
-	if (count == 0 || count > 8)
-		return false;
-	return mask & (1u << (count - 1));
-}
