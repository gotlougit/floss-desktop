-		int ret;
-		const struct media_codec *media_codec = get_supported_media_codec(this, codec, NULL,
-				SPA_BT_PROFILE_HEADSET_AUDIO);
-
-		this->switching_codec = true;
-
-		ret = spa_bt_device_ensure_hfp_codec(this->bt_dev, media_codec);
-		if (ret < 0) {
-			if (ret != -ENOTSUP)
