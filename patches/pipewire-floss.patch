-			if (this->enc[ich] == NULL) {
-				res = -EINVAL;
-				goto error;
-			}
-		}
-	} else {
-		for (ich = 0; ich < this->channels; ich++) {
-			this->dec[ich] = lc3_setup_decoder(this->frame_dus, this->codec_samplerate, 0,
-					calloc(1, lc3_decoder_size(this->frame_dus, this->codec_samplerate)));
