-
-	for (i = 0; i < port->n_buffers; i++) {
-		struct buffer *b = &port->buffers[i];
-
-		if (port->direction == SPA_DIRECTION_OUTPUT) {
-			spa_list_append(&port->free, &b->link);
-			b->outgoing = false;
-		} else {
-			b->outgoing = true;
