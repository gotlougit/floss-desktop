-	while (dbus_message_iter_get_arg_type(props_i) != DBUS_TYPE_INVALID) {
-		DBusMessageIter i, value_i;
-		const char *key, *value;
-		char c;
-
-		dbus_message_iter_recurse(props_i, &i);
-
-		dbus_message_iter_get_basic(&i, &key);
-		dbus_message_iter_next(&i);
