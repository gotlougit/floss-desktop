-	if (this->props.has_latency) {
-		node_info_items[n_items].key = SPA_KEY_NODE_LATENCY;
-		node_info_items[n_items].value = this->props.latency;
-		n_items++;
-	} else if (!this->is_input && this->node_latency != 0) {
