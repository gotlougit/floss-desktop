-		register_media_endpoint(monitor, codec, SPA_BT_MEDIA_SOURCE);
-		register_media_endpoint(monitor, codec, SPA_BT_MEDIA_SINK);
-		if (codec->kind == MEDIA_CODEC_BAP) {
