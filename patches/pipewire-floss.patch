-static bool validate_phone_number(const char *number)
-{
-	const char *c;
-	int count = 0;
-
-	if (!number)
-		return false;
-	for (c = number; *c != '\0'; c++) {
-		if (!(*c >= '0' && *c <= '9') && !(*c >= 'A' && *c <= 'D') &&
-			*c != '#' && *c != '*' && *c != '+' && *c != ',' )
-			return false;
-		count++;
-	}
-	if (count < 1 || count > 80)
-		return false;
-	return true;
-}
-
-static bool validate_tones(const char *tones)
-{
-	const char *c;
-	if (!tones)
-		return false;
-	for (c = tones; *c != '\0'; c++) {
-		if (!(*c >= '0' && *c <= '9') && !(*c >= 'A' && *c <= 'D') &&
-				*c != '#' && *c != '*')
-			return false;
-	}
-	return true;
-}
