-
-	agimpl->path = spa_steal_ptr(path);
-
-	/* notify on ObjectManager of the Manager object */
-	{
-		spa_autoptr(DBusMessage) msg = NULL;
-		DBusMessageIter iter;
-
-		msg = dbus_message_new_signal(impl->path, DBUS_INTERFACE_OBJECT_MANAGER,
