-	}
-
-	for (i = 0; bluez5_codec_a2dp->codecs[i]; ++i) {
-		const struct media_codec *c = bluez5_codec_a2dp->codecs[i];
-		const char *ep = c->endpoint_name ? c->endpoint_name : c->name;
-		size_t j;
-
-		if (!ep)
