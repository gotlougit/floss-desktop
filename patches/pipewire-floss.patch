-
-	res = sbc_encode(&this->sbc, src, src_size,
-			dst, dst_size, (ssize_t*)dst_out);
-	if (SPA_UNLIKELY(res < 0))
-		return -EINVAL;
-	spa_assert(res == this->codesize);
