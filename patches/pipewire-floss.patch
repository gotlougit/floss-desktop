-static void device_set_get_dset_info(const struct device_set *dset,
-		int *n_set_sink, int *n_set_source)
-{
-	if (dset->sink_enabled)
-		*n_set_sink = dset->leader ? 1 : 0;
-	if (dset->source_enabled)
