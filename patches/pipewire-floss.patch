-	if (!(info && spa_atob(spa_dict_lookup(info, SPA_KEY_API_GLIB_MAINLOOP)))) {
-		spa_log_error(this->log, "Glib mainloop is not usable: %s not set",
-				SPA_KEY_API_GLIB_MAINLOOP);
