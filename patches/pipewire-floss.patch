-                          20456, 12896,  8968,   6288,  4240,  2584,  1200,  0};
-static int16_t qm2[4] = {-7408, -1616, 7408, 1616};
-static int16_t qmf_coeffs[12] = {
-        3, -11, 12, 32, -210, 951, 3876, -805, 362, -156, 53, -11,
-};
