-		bluez5_gatt_characteristic1_call_acquire_write(
-				BLUEZ5_GATT_CHARACTERISTIC1(this->proxy),
-				options,
-				NULL,
-				port->acquire_call,
-				acquire_write_reply,
-				port);
-	}
-
-	return 0;
-}
