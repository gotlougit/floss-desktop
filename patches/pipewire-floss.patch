-static uint32_t parse_locations(const char *str)
-{
-	char *s, *p, *save = NULL;
-	uint32_t location = 0;
-
-	if (!str)
-		return 0;
-
-	s = strdup(str);
-	if (s == NULL)
-		return 0;
-
-	for (p = s; (p = strtok_r(p, ", ", &save)) != NULL; p = NULL) {
-		if (*p == '\0')
-			continue;
-		location |= bt_channel_from_name(p);
-	}
-	free(s);
-
-	return location;
-}
