-		} while (0)
-
-#define PREFER_BOOL(expr)	PREFER_EXPR((expr) ? 1 : 0)
-
-	/* Prefer valid */
-	a = (res1 > 0 && (size_t)res1 == sizeof(a2dp_opus_g_t)) ? 1 : 0;
