-static const struct media_codec_config
-aptx_frequencies[] = {
-	{ APTX_SAMPLING_FREQ_48000, 48000, 3 },
-	{ APTX_SAMPLING_FREQ_44100, 44100, 2 },
-	{ APTX_SAMPLING_FREQ_32000, 32000, 1 },
-	{ APTX_SAMPLING_FREQ_16000, 16000, 0 },
