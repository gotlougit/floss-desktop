@@ -0,0 +1,11 @@
+# Floss desktop audio policy. The normal main profile manages the stable
+# Audio/Sink and headset Audio/Source nodes from the automatic pw-floss bridge.
+# Ordinary recording links activate the headset source; the bridge owns HFP
+# switching and idle return to A2DP. WirePlumber does not run a second profile
+# coordinator. Start the bridge through the deployment's user service.
+#
+# Optionally mute ALSA output routes when a running Floss sink disappears,
+# preventing fallback to speakers from unexpectedly exposing playback.
+# wireplumber.settings = {
+#   device.routes.mute-on-bluetooth-playback-removed = true
+# }
