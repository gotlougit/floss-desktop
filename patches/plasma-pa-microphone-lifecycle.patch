+    void releaseStream(pa_stream *&stream)
+    {
+        auto *old = std::exchange(stream, nullptr);
+        if (!old) return;
+        pa_stream_set_state_callback(old, nullptr, nullptr);
+        pa_stream_set_read_callback(old, nullptr, nullptr);
+        pa_stream_set_write_callback(old, nullptr, nullptr);
+        if (pa_stream_get_state(old) == PA_STREAM_CREATING) {
+            // PulseAudio cannot disconnect until creation finishes. Keep the
+            // owned reference in a callback that does not reference the UI.
+            pa_stream_set_state_callback(old, [](pa_stream *pending, void *) {
+                const auto state = pa_stream_get_state(pending);
+                if (state == PA_STREAM_CREATING) return;
+                pa_stream_set_state_callback(pending, nullptr, nullptr);
+                if (state == PA_STREAM_READY) pa_stream_disconnect(pending);
+                pa_stream_unref(pending);
+            }, nullptr);
+            return;
+        }
+        if (pa_stream_get_state(old) == PA_STREAM_READY) pa_stream_disconnect(old);
+        pa_stream_unref(old);
+    }
