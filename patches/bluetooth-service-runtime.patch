index 0000000..a2d5e02
--- /dev/null
+++ b/system/gd/rust/linux/mgmt/src/rfkill.rs
@@ -0,0 +1,197 @@
+//! Per-controller Linux rfkill access. Never emits CHANGE_ALL or addresses a non-Bluetooth radio.
+use std::fs::{self, File};
+use std::io::{self, Read};
+use std::path::Path;
+
+const MAX_ENTRIES: usize = 256;
+const MAX_ATTRIBUTE_BYTES: u64 = 64;
+const RFKILL_TYPE_BLUETOOTH: u8 = 2;
+const RFKILL_OP_CHANGE: u8 = 2;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Switch {
+    index: u32,
+    pub hard_blocked: bool,
+    pub soft_blocked: bool,
+}
+
+fn attribute(path: &Path) -> Option<String> {
+    let mut value = String::new();
+    File::open(path).ok()?.take(MAX_ATTRIBUTE_BYTES + 1).read_to_string(&mut value).ok()?;
+    if value.len() > MAX_ATTRIBUTE_BYTES as usize {
+        return None;
+    }
+    Some(value.trim().to_owned())
+}
+
+fn boolean(path: &Path) -> Option<bool> {
+    match attribute(path)?.as_str() {
+        "0" => Some(false),
+        "1" => Some(true),
+        _ => None,
+    }
+}
+
+/// Only kernel hciN switches can be safely mapped to a specific adapter. A platform-wide switch
+/// with another name is deliberately not guessed from enumeration order or controller count.
+pub(crate) fn read(root: &Path, real_hci: i32) -> Option<Switch> {
+    if real_hci < 0 {
+        return None;
+    }
+    let name = format!("hci{}", real_hci);
+    let mut matched = None;
+    for (count, entry) in fs::read_dir(root).ok()?.enumerate() {
+        if count >= MAX_ENTRIES {
+            return None;
+        }
+        let entry = entry.ok()?;
+        let filename = entry.file_name();
+        let filename = filename.to_str()?;
+        let index: u32 = match filename.strip_prefix("rfkill").and_then(|s| s.parse().ok()) {
+            Some(index) if filename == format!("rfkill{}", index) => index,
+            _ => continue,
+        };
+        let path = entry.path();
+        if attribute(&path.join("type"))?.as_str() != "bluetooth" {
+            continue;
+        }
+        if attribute(&path.join("name"))? != name {
+            continue;
+        }
+        // Ambiguity, transient removal or malformed state must never produce a write target.
+        if matched.is_some() {
+            return None;
+        }
+        matched = Some(Switch {
+            index,
+            hard_blocked: boolean(&path.join("hard"))?,
+            soft_blocked: boolean(&path.join("soft"))?,
+        });
+    }
+    matched
+}
+
+/// Success means the kernel accepted the request, not that a concurrent hardware switch cannot
+/// change state afterward. Callers must refresh state. An unblock cannot override a hard block.
+pub(crate) fn set<F>(root: &Path, real_hci: i32, blocked: bool, mut write_event: F) -> bool
+where
+    F: FnMut(&[u8; 8]) -> io::Result<()>,
+{
+    let switch = match read(root, real_hci) {
+        Some(switch) => switch,
+        None => return false,
+    };
+    if !blocked && switch.hard_blocked {
+        return false;
+    }
+    if switch.soft_blocked == blocked {
+        return true;
+    }
+    // Linux UAPI struct rfkill_event is packed: native-endian u32 index, type/op/soft/hard u8.
+    let mut event = [0u8; 8];
+    event[..4].copy_from_slice(&switch.index.to_ne_bytes());
+    event[4] = RFKILL_TYPE_BLUETOOTH;
+    event[5] = RFKILL_OP_CHANGE;
+    event[6] = u8::from(blocked);
+    write_event(&event).is_ok()
+}
