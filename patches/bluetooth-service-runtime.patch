+        fixture.radio(2, "bluetooth", "hci0", "2", "0");
+        assert!(!set(&fixture.0, 0, true, |_| panic!("malformed write")));
+        fs::write(fixture.0.join("rfkill2/hard"), "0".repeat(65)).unwrap();
