+// The sender comes from the bus message, never a client-provided string.
+// Called by the exporter while holding the SocketManager mutation lock.
+fn authorize_socket_callback(
+    manager: &BluetoothSocketManager,
+    context: &dbus_crossroads::Context,
+    callback: &CallbackId,
+) -> Result<(), dbus_crossroads::MethodErr> {
+    let allowed = context.message().sender()
+        .map_or(false, |sender| manager.is_callback_owner(*callback, &sender));
+    if allowed {
+        Ok(())
+    } else {
+        Err(("org.freedesktop.DBus.Error.AccessDenied", "Socket callback belongs to another client").into())
+    }
+}
