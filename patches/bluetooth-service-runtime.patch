+    }
+
+    #[test]
+    fn write_failure_is_reported_and_unblock_event_is_scoped() {
+        let fixture = Fixture::new();
+        fixture.radio(9, "bluetooth", "hci3", "0", "1");
+        assert!(!set(&fixture.0, 3, false, |_| Err(io::ErrorKind::PermissionDenied.into())));
+        assert!(set(&fixture.0, 3, false, |event| {
+            assert_eq!(&event[4..], &[2, 2, 0, 0]);
+            assert_eq!(&event[..4], &9u32.to_ne_bytes());
+            Ok(())
+        }));
+    }
+
+    #[test]
+    fn enumeration_is_bounded() {
+        let fixture = Fixture::new();
+        fixture.radio(0, "bluetooth", "hci0", "0", "0");
+        for index in 1..=MAX_ENTRIES {
+            fs::create_dir(fixture.0.join(format!("entry{}", index))).unwrap();
+        }
+        assert!(!set(&fixture.0, 0, true, |_| panic!("unbounded directory write")));
+    }
+}
