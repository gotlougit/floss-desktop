 impl IBluetoothManager for BluetoothManager {
+    fn get_rfkill_state(&mut self, hci_interface: i32) -> RfkillState {
+        let real_hci = self
+            .proxy
+            .get_state(VirtualHciIndex(hci_interface), |state| Some(state.real_hci.to_i32()));
+        match real_hci
+            .and_then(|hci| crate::rfkill::read(std::path::Path::new("/sys/class/rfkill"), hci))
+        {
+            Some(state) => RfkillState {
+                available: true,
+                hard_blocked: state.hard_blocked,
+                soft_blocked: state.soft_blocked,
+            },
+            None => RfkillState::default(),
+        }
+    }
+
+    fn set_rfkill_blocked(&mut self, hci_interface: i32, blocked: bool) -> bool {
+        use std::io::Write;
+        use std::os::unix::fs::OpenOptionsExt;
+        let real_hci = self
+            .proxy
+            .get_state(VirtualHciIndex(hci_interface), |state| Some(state.real_hci.to_i32()));
+        match real_hci {
+            Some(hci) => crate::rfkill::set(
+                std::path::Path::new("/sys/class/rfkill"),
+                hci,
+                blocked,
+                |event| {
+                    // Nonblocking and write-only: never drain the kernel event stream or wait for it.
+                    // A short write is an error; do not issue a second partial rfkill record.
+                    let mut fd = std::fs::OpenOptions::new()
+                        .write(true)
+                        .custom_flags(libc::O_NONBLOCK | libc::O_CLOEXEC | libc::O_NOFOLLOW)
+                        .open("/dev/rfkill")?;
+                    if fd.write(event)? != event.len() {
+                        return Err(std::io::ErrorKind::WriteZero.into());
+                    }
+                    Ok(())
+                },
+            ),
+            None => false,
+        }
+    }
+
     fn start(&mut self, hci: i32) {
         let hci = VirtualHciIndex(hci);
         warn!("Starting {}", hci);
